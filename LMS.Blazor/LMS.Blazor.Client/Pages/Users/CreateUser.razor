
@page "/users/create"
@using LMS.Blazor.Client.Services
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Shared.Constants
@using LMS.Shared.DTOs.Users
@using LMS.Shared.DTOs.CourseDtos
@using Microsoft.AspNetCore.Authorization
@using System.Net
@using System.Net.Http.Json
@attribute [Authorize(Roles = UserRoles.Teacher)]
@inject ICourseService CourseService
@inject NavigationManager navigationManager
@inject ToastService ToastService
@inject IApiProxyClient ApiProxy

<div class="container mt-4">
    <div class="col-md-6">
        <h3>Lägg till en användare</h3>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <EditForm Model="@model" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <div class="mb-3">
                <label class="form-label">Förnamn:</label>
                <InputText @bind-Value="model.FirstName" class="form-control" />
                <ValidationMessage For="@(() => model.FirstName)" />
            </div>
            <div class="mb-3">
                <label class="form-label">Efternamn:</label>
                <InputText @bind-Value="model.LastName" class="form-control" />
                <ValidationMessage For="@(() => model.LastName)" />
            </div>

            <div class="mb-3">
                <label class="form-label">E-post:</label>
                <InputText @bind-Value="model.Email" class="form-control" />
                <ValidationMessage For="@(() => model.Email)" />
            </div>

            <div class="mb-3">
                <label class="form-label">Lösenord:</label>
                <InputText @bind-Value="model.Password" class="form-control" type="password" />
                <ValidationMessage For="@(() => model.Password)" />
            </div>

            <div class="mb-3">
                <label class="form-label">Roll:</label>
                <InputSelect @bind-Value="model.Role" class="form-control">
                    <option value="">Välj roll...</option>
                    @foreach (var role in UserRoles.All)
                    {
                        <option value="@role">@role</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => model.Role)" />
            </div>

            <div class="mb-3">
                <label class="form-label">Kurs:</label>
                <InputSelect @bind-Value="model.CourseId" class="form-control">
                    <option value="">Välj kurs...</option>
                    @if (courses != null)
                    {
                        @foreach (var course in courses)
                        {
                            <option value="@course.Id">@course.Name</option>
                        }
                    }
                </InputSelect>
                <ValidationMessage For="@(() => model.CourseId)" />
           </div>

            <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span>Skapar...</span>
                }
                else
                {
                    <span>Skapar användare</span>
                }
            </button>
            
            <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">Avbryt</button>
        </EditForm>
    </div>
</div>

@code {
    private string? returnUrl;
    private CreateUserDto model = new();
    private bool isSubmitting = false;
    private string? errorMessage;
    private IEnumerable<CourseLookupDto>? courses;

    protected override async Task OnInitializedAsync()
    {
        GetReturnUrlFromQuery();

        await LoadCourseLookupsAsync();
    }

    private void GetReturnUrlFromQuery()
    {
        var uri = new Uri(navigationManager.Uri);
        var query = uri.Query;

        if (!string.IsNullOrEmpty(query))
        {
            // Simple split to find returnUrl=...
            var queryParams = query.TrimStart('?').Split('&');
            foreach (var param in queryParams)
            {
                var parts = param.Split('=');
                if (parts.Length == 2 && parts[0] == "returnUrl")
                {
                    returnUrl = Uri.UnescapeDataString(parts[1]);

                    if (returnUrl.Contains("/teacher/courses/"))
                    {
                        var segments = returnUrl.Split('/');
                        for (int i = 0; i < segments.Length - 1; i++)
                        {
                            if (segments[i] == "courses" && int.TryParse(segments[i + 1].Split('?')[0], out int courseId))
                            {
                                model.CourseId = courseId; // Set default dropdown value
                                model.Role = UserRoles.Student; // Set default role to Student
                                break;
                            }
                        }
                    }

                    break;
                }
            }
        }
    }

    private async Task LoadCourseLookupsAsync()
    {
        courses = await CourseService.GetCourseLookupsAsync();
    }

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            if (model.Role == UserRoles.Student && (!model.CourseId.HasValue || model.CourseId.Value <= 0))
            {
                errorMessage = "Student måste tilldelas en kurs.";
                return;
            }

            using var content = JsonContent.Create(model);
            var (data, responseErrorMessage) = await ApiProxy.SendAndHandleErrorAsync<bool>(
                    HttpMethod.Post,
                    "users",
                    content
            );

            if (string.IsNullOrEmpty(responseErrorMessage))
            {
                ToastService.ShowToast($"Användare {model.FirstName} {model.LastName} har skapats.", ToastType.Success);

                NavigateToReturnUrl();
            }
            else
            {
                errorMessage = responseErrorMessage ?? "Det gick inte att skapa användaren.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ett fel uppstod: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancel()
    {
        NavigateToReturnUrl();
    }

    private void NavigateToReturnUrl()
    {
        if (!string.IsNullOrEmpty(returnUrl))
        {
            navigationManager.NavigateTo(Uri.UnescapeDataString(returnUrl));
        }
        else
        {
            navigationManager.NavigateTo("/users");
        }
    }
}