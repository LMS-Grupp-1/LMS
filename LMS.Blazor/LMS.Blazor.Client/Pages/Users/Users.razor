@page "/users"
@using Microsoft.AspNetCore.Authorization
@using LMS.Blazor.Client.Services
@using LMS.Shared.DTOs.Users
@using LMS.Blazor.Client.Components.Common
@attribute [Authorize(Roles = "Teacher")]
@inject NavigationManager Navigation
@inject IUsersService UsersService
@inject ToastService ToastService

<PageTitle>Användarhantering</PageTitle>

<div class="container mt-4">
    @if (users == null)
{
    <h3 class="mb-3">Administrera Användare</h3>
    <p><em>Laddar användare...</em></p>
}
else if (!users.Any())
{
    <h3 class="mb-3">Administrera Användare</h3>
    <p>Inga användare hittades.</p>
}
else
{
     <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Administrera Användare</h3>
        <button class="btn btn-primary" @onclick="NavigeraToCreateUser">
            <i class="bi bi-plus-circle"></i> Lägga till en användare
        </button>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Förnamn</th>
                <th>Efternamn</th>
                <th>E-post</th>
                <th>Roll</th>
                <th>Kopplad Kurs</th>
                <th>Åtgärder</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in users)
            {
                <tr>
                    <td>@user.FirstName</td>
                    <td>@user.LastName</td>
                    <td>@user.Email</td>
                    <td>@user.Role</td>
                    <td>
                        @if (user.CourseId != null)
                        {
                            <NavLink href="@($"/teacher/courses/{user.CourseId}")">
                                @user.CourseName
                            </NavLink>
                        }
                        else
                        {
                            <span class="text-muted">Ingen kurs</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditUser(user.Id)">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => PromptDeleteUser(user.Id, user.FirstName, user.LastName)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>   
}
</div>

<ConfirmDialog IsOpen="showDeleteModal"
               Title="@($"Ta bort användare: {deleteUserName}")"
               Message="Är du säker på att du vill ta bort denna användare? Denna åtgärd går inte att ångra."
               ConfirmButtonText="Ta bort"
               ConfirmButtonClass="btn-danger"
               OnCancel="CloseDeleteModal"
               OnConfirm="ConfirmDeleteUserAsync" />

@code {
    private IEnumerable<UserDto>? users;
    private bool showDeleteModal = false;
    private string? userToDeleteId = null;
    private string? deleteUserName = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        users = await UsersService.GetUsersAsync();
        StateHasChanged();
    }

    private void NavigeraToCreateUser()
    {
        Navigation.NavigateTo("/users/create");
    }

    private void EditUser(string id)
    {
        Navigation.NavigateTo($"/users/edit/{id}");
    }

    private void PromptDeleteUser(string userId, string firstName, string lastName)
    {
        userToDeleteId = userId;
        deleteUserName = $"{firstName} {lastName}";
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        userToDeleteId = null;
        deleteUserName = null;
    }

    private async Task ConfirmDeleteUserAsync()
    {
        if (string.IsNullOrEmpty(userToDeleteId)) return;

        var success = false;
        // await UsersService.DeleteUserAsync(userToDeleteId);
        
        if (success)
        {
            CloseDeleteModal();
            ToastService.ShowToast("Användaren har tagits bort framgångsrikt.", ToastType.Success);
            await LoadUsersAsync(); 
        }
        else
        {
            CloseDeleteModal();
            ToastService.ShowToast("Kunde inte ta bort användaren. Försök igen senare.", ToastType.Danger);
        }
    }
}