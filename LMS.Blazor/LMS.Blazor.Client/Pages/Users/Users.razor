@page "/users"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Logging
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Shared.Constants
@using LMS.Shared.DTOs.Users

@attribute [Authorize(Roles = UserRoles.Teacher)]

@inject NavigationManager Navigation
@inject IApiProxyClient ApiProxy
@inject ILogger<Users> Logger

<PageTitle>Användare</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">Användare</h1>
            <p class="text-muted mb-0">
                Hantera användare och deras kurskopplingar.
            </p>
        </div>

        <button type="button"
                class="btn btn-primary d-flex align-items-center gap-2 shadow-sm"
                @onclick="NavigeraToCreateUser">
            <i class="bi bi-plus-lg" aria-hidden="true"></i>
            Ny användare
        </button>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="p-4 text-muted" role="status">
                    <span class="spinner-border spinner-border-sm me-2"
                          aria-hidden="true"></span>
                    Laddar användare...
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(errorMsg))
            {
                <div class="p-4">
                    <div class="alert alert-danger" role="alert">
                        @errorMsg
                    </div>

                    <button type="button"
                            class="btn btn-outline-primary"
                            @onclick="LoadUsersAsync">
                        Försök igen
                    </button>
                </div>
            }
            else if (!users.Any())
            {
                <p class="p-4 mb-0 text-muted">
                    Inga användare hittades.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <caption class="visually-hidden">
                            Användare, roller och kopplade kurser
                        </caption>

                        <thead class="table-light text-secondary">
                            <tr>
                                <th scope="col" class="py-3 ps-4">Förnamn</th>
                                <th scope="col" class="py-3">Efternamn</th>
                                <th scope="col" class="py-3">E-post</th>
                                <th scope="col" class="py-3">Roll</th>
                                <th scope="col" class="py-3">Kurs</th>
                                <th scope="col" class="py-3 text-end pe-4">
                                    Åtgärder
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var user in users)
                            {
                                <tr @key="user.Id">
                                    <td class="ps-4">@user.FirstName</td>
                                    <td>@user.LastName</td>
                                    <td>@user.Email</td>
                                    <td>
                                        @(user.Role switch
                                        {
                                            UserRoles.Teacher => "Lärare",
                                            UserRoles.Student => "Student",
                                            _ => user.Role
                                        })
                                    </td>
                                    <td>

                                        @if (user.CourseId is int courseId)
                                        {
                                            <a href="@($"/teacher/courses/{courseId}")"
                                               class="text-decoration-none">
                                                @user.CourseName
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Ingen kurs
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                aria-label="@($"Redigera {user.FirstName} {user.LastName}")"
                                                @onclick="() => EditUser(user.Id)">
                                            <i class="bi bi-pencil"
                                               aria-hidden="true"></i>
                                            <span class="ms-1">Redigera</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private IEnumerable<UserDto> users = Enumerable.Empty<UserDto>();
    private string? errorMsg;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        isLoading = true;
        errorMsg = null;

        try
        {
            users = await ApiProxy.GetAsync<IEnumerable<UserDto>>(
                "users") ?? Enumerable.Empty<UserDto>();
        }
        catch (UnauthorizedAccessException)
        {
            errorMsg = "Din session har gått ut. Logga in igen.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load users.");
            errorMsg = "Användarna kunde inte hämtas. Försök igen.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NavigeraToCreateUser()
    {
        Navigation.NavigateTo("/users/create");
    }

    private void EditUser(string id)
    {
        Navigation.NavigateTo($"/users/edit/{id}");
    }
}