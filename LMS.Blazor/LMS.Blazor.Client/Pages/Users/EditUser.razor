@page "/users/edit/{Id}"
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using LMS.Shared.DTOs.Users
@using LMS.Shared.DTOs.CourseDtos
@using LMS.Blazor.Client.Services
@using LMS.Shared.Constants
@using LMS.Blazor.Client.Services.ApiProxy
@attribute [Authorize(Roles = UserRoles.Teacher)]
@inject IUsersService UsersService
@inject IApiProxyClient ApiProxy
@inject NavigationManager navigationManager
@inject ToastService ToastService

<div class="container mt-4">
    <div class="col-md-6">
        <h3>Redigera Användare</h3>

        @if (isLoading)
        {
            <p><em>Laddar användare...</em></p>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }
        <EditForm Model="model" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label for="firstName" class="form-label">Förnamn</label>
                <InputText id="firstName" class="form-control" @bind-Value="model.FirstName" />
             </div>
             <div class="mb-3">
                <label for="lastName" class="form-label">Efternamn</label>
                <InputText id="lastName" class="form-control" @bind-Value="model.LastName" />
             </div>

             <div class="mb-3">
                 <label for="email" class="form-label">Email</label>
                 <InputText id="email" class="form-control" @bind-Value="model.Email" />
             </div>

             <div class="mb-3">
                <label class="form-label">Roll:</label>
                <InputSelect @bind-Value="model.Role" class="form-control">
                    <option value="">Välj roll...</option>
                    <option value="Student">Student</option>
                    <option value="Teacher">Teacher</option>
                 </InputSelect>
                 <ValidationMessage For="@(() => model.Role)" />
              </div>

              <div class="mb-3">
                  <label class="form-label">Kurs:</label>
                  <InputSelect @bind-Value="model.CourseId" class="form-control">
                        <option value="">Välj kurs...</option>
                        @if (courses != null)
                        {
                            @foreach (var course in courses)
                            {
                                <option value="@course.Id">@course.Name</option>
                            }
                        }
                    </InputSelect>
                  <ValidationMessage For="@(() => model.CourseId)" />
              </div>

                <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span> Sparar...</span>
                    }
                    else
                    {
                        <span>Spara ändringar</span>
                    }
                </button>
                <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">Avbryt</button>
            </EditForm>
    </div>
</div>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private UpdateUserDto model = new();
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? errorMessage;
    private IEnumerable<CourseLookupDto>? courses;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = await UsersService.GetUserByIdAsync(Id);
            if (user == null)
            {
                errorMessage = "Användaren hittades inte.";
            }
            else
            {
                model = new UpdateUserDto
                {
                    Id = user.Id,
                    Email = user.Email,
                    FirstName = user.FirstName,
                    LastName = user.LastName,
                    Role = user.Role,
                    CourseId = user.CourseId
                };
            }

            await LoadCourseLookupsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Kunde inte ladda användardata: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NavigateToReturnUrl()
    {
        if (!string.IsNullOrEmpty(ReturnUrl))
        {
            navigationManager.NavigateTo(Uri.UnescapeDataString(ReturnUrl));
        }
        else
        {
            navigationManager.NavigateTo("/users");
        }
    }

    private async Task LoadCourseLookupsAsync()
    {
        try
        {
            courses = await ApiProxy.GetAsync<IEnumerable<CourseLookupDto>>(
                "courses/lookups") ?? Enumerable.Empty<CourseLookupDto>();
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "Din session har gått ut. Logga in igen.";
        }
        catch (Exception)
        {
            errorMessage = "Kurslistan kunde inte hämtas. Försök igen.";
        }
    }

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            bool success = await UsersService.UpdateUserAsync(model);
            
            if (success)
            {
                ToastService.ShowToast($"Användare {model.FirstName} {model.LastName} uppdaterad successfully.", ToastType.Success);

                NavigateToReturnUrl();
            }
            else
            {
                errorMessage = "Misslyckades med att uppdatera användaren.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ett fel uppstod: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancel()
    {
        NavigateToReturnUrl();
    }
}