@rendermode @(new Microsoft.AspNetCore.Components.Web.InteractiveWebAssemblyRenderMode(prerender: false))
@page "/teacher/courses"
@using Microsoft.Extensions.Logging
@using Microsoft.AspNetCore.Authorization
@using LMS.Shared.DTOs.CourseDtos
@using LMS.Blazor.Client.Services
@attribute [Authorize(Roles = "Teacher")]
@inject ICourseApiService CourseApiService
@inject ILogger<TeacherCourseOverview> Logger

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>Teacher Course Overview</h3>
    <button class="btn btn-primary" @onclick="OpenCreateModal">
        + Skapa ny kurs
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(actionError))
{
    <div class="alert alert-danger" role="alert">
        @actionError
    </div>
}

@if (isLoading)
{
    <div class="d-flex align-items-center gap-2 my-4" role="status">
        <div class="spinner-border text-primary" aria-hidden="true"></div>
        <span>Kurser laddas...</span>
    </div>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <div class="alert alert-danger" role="alert">
        @loadError
        <button class="btn btn-outline-danger ms-2" @onclick="LoadCourses">
            Försök igen
        </button>
    </div>
}
else if (courses != null && !courses.Any())
{
    <div class="alert alert-info">
        Det finns inga kurser registrerade. Klicka på "+ Skapa ny kurs" för att lägga till din första kurs.
    </div>
}
else if (courses != null)
{
    <div class="row">
        @foreach (var course in courses)
        {
            <div @key="course.Id" class="col-md-4 mb-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@course.Name</h5>
                        <p class="card-text">@course.Description</p>
                    </div>
                    <div class="card-footer bg-white d-flex justify-content-between align-items-center">
                        <small class="text-muted">
                            @course.StartDate.ToShortDateString() - @course.EndDate.ToShortDateString()
                        </small>
                        <div>
                            <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditModal(course)">
                                Redigera
                            </button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCourse(course.Id)">
                                Radera
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@* --- MODUL FOR EDITING --- *@
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditing ? "Redigera kurs" : "Skapa ny kurs")</h5>
                    <button type="button" class="btn-close" disabled="@isBusy" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(formError))
                    {
                        <div class="alert alert-danger" role="alert">
                            @formError
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Course Name</label>
                        <input type="text" class="form-control" @bind="courseForm.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" rows="3" @bind="courseForm.Description"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Start Date</label>
                            <input type="date" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" @bind="courseForm.StartDate" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">End Date</label>
                            <input type="date" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" @bind="courseForm.EndDate" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" disabled="@isBusy" @onclick="CloseModal">Cancel</button>
                    <button type="button" class="btn btn-success" disabled="@isBusy" @onclick="SaveCourse">
                        @(isEditing ? "Spara ändringar" : "Skapa kurs")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IEnumerable<CourseDto>? courses;
    private bool showModal = false;
    private bool isEditing = false;
    private bool isLoading = true;
    private string? loadError;
    private string? actionError;
    private string? formError;
    private bool isBusy;
    private int editingCourseId = 0;

    private CourseFormModel courseForm = new();

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive)
            return;

        await LoadCourses();
    }

    private async Task LoadCourses()
    {
        isLoading = true;
        loadError = null;
        StateHasChanged();

        try
        {
            courses = await CourseApiService.GetAllCoursesAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "Sessionen har utlöpt medan kurserna laddades.");
            loadError = "Din session har utlöpt. Vänligen logga in igen.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Kurserna kunde inte laddas.");
            loadError = "Kurserna kunde inte laddas. Försök igen.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void OpenCreateModal()
    {
        formError = null;
        actionError = null;
        isEditing = false;
        courseForm = new CourseFormModel
        {
            StartDate = DateTime.Today,
            EndDate = DateTime.Today.AddMonths(1)
        };
        showModal = true;
    }

    private void OpenEditModal(CourseDto course)
    {
        formError = null;
        actionError = null;
        isEditing = true;
        editingCourseId = course.Id;
        courseForm = new CourseFormModel
        {
            Name = course.Name,
            Description = course.Description,
            StartDate = course.StartDate,
            EndDate = course.EndDate
        };
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task SaveCourse()
    {
        if (isBusy) return;

        formError = null;

        if (string.IsNullOrWhiteSpace(courseForm.Name) ||
            courseForm.Name.Trim().Length > 50)
        {
            formError = "Registrera ett kursnamn mellan 1-50 tecken.";
            return;
        }

        if (courses != null && courses.Any(course =>
            (!isEditing || course.Id != editingCourseId) && string.Equals(
                course.Name.Trim(),
                courseForm.Name.Trim(),
                StringComparison.OrdinalIgnoreCase)))
        {
            formError = "Det existerar redan en kurs med det här namnet.";
            return;
        }

        var today = DateTime.Today;

        if (courseForm.StartDate.Date < today ||
            courseForm.EndDate.Date < today)
        {
            formError = "Kursdatum får inte ligga före dagens datum.";
        }

    if (courseForm.StartDate > courseForm.EndDate)
    {
        formError = "Startdatum får inte ligga efter slutdatum.";
        return;
    }

    isBusy = true;

    try
    {
        bool success;

        if (isEditing)
        {
            var dto = new CourseUpdateDto(
                courseForm.Name.Trim(),
                courseForm.Description,
                courseForm.StartDate,
                courseForm.EndDate);

            success = await CourseApiService.UpdateCourseAsync(
                editingCourseId, dto);
        }
        else
        {
            var dto = new CourseCreateDto(
                courseForm.Name.Trim(),
                courseForm.Description,
                courseForm.StartDate,
                courseForm.EndDate);

            success = await CourseApiService.CreateCourseAsync(dto);
        }

        if (!success)
        {
            formError = "Kursen kunde inte sparas. Vänligen försök igen.";
            return;
        }

        CloseModal();
        await LoadCourses();
    }
    catch (UnauthorizedAccessException ex)
    {
        Logger.LogWarning(ex, "Sessionen har utlöpt medan kursen sparades.");
        formError = "Din session har utlöpt. Logga in igen.";
    }
    catch (Exception ex)
    {
        Logger.LogError(ex, "Kursen kunde inte sparas.");
        formError = "Kursen kunde inte sparas. Vänligen försök igen.";
    }
    finally
    {
        isBusy = false;
    }
}


    private async Task DeleteCourse(int id)
{
    if (isBusy) return;

    isBusy = true;
    actionError = null;

    try
    {
        var success = await CourseApiService.DeleteCourseAsync(id);

        if (success)
        {
            await LoadCourses();
        }
        else
        {
            actionError = "Kursen kunde inte raderas. Vänligen försök igen.";
        }
    }
    catch (UnauthorizedAccessException ex)
    {
        Logger.LogWarning(ex, "Sessionen utlöpte medan kursen raderades.");
        actionError = "Din session har utlöpt. Vänligen logga in igen.";
    }
    catch (Exception ex)
    {
        Logger.LogError(ex, "Kursen med id {CourseId} kunde inte raderas.", id);
        actionError = "Kursen kunde inte raderas. Försök igen.";
    }
    finally
    {
        isBusy = false;
    }
}

    public class CourseFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public DateTime StartDate { get; set; } = DateTime.Today;
        public DateTime EndDate { get; set; } = DateTime.Today.AddMonths(1);
    }
}