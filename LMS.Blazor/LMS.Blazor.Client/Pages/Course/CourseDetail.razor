@page "/teacher/courses/{CourseId:int}"
@using Microsoft.AspNetCore.Authorization
@using LMS.Shared.DTOs.CourseDtos
@using LMS.Blazor.Client.Services
@using LMS.Blazor.Client.Components.Courses
@using LMS.Blazor.Client.Components.Modules
@using LMS.Blazor.Client.Components.Users
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Blazor.Client.Components.Submissions
@using LMS.Blazor.Client.Components.Common
@attribute [Authorize(Roles = "Teacher")]
@inject IApiProxyClient ApiProxy
@inject ToastService ToastService

<div class="container p-0 my-4">

    <nav aria-label="Brödsmulor" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
                <a href="/teacher/courses">Kurser</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                @(currentCourse?.Name ?? "Kurs")
            </li>
        </ol>
    </nav>

    <div class="card px-0 pb-4 mb-4 border-0 bg-light">
        <div class="d-flex align-items-start gap-3">
            <div class="flex-shrink-0">
                <AppIconBox Type="course" CustomClasses="theme-box-background" />
            </div>
            <div class="flex-grow-1">
                <h1 class="h3 fw-bold mb-2">@(currentCourse?.Name ?? (isLoading ? "Laddar kurs..." : "Kurs"))</h1>
                <p class="text-secondary">@(currentCourse?.Description ?? string.Empty)</p>
                
                @if (currentCourse != null)
                {
                    <div class="d-flex align-items-center text-muted small gap-3">
                        <div>
                            <i class="bi bi-calendar-range me-1 text-dark"></i>
                            <span>@currentCourse.StartDate.ToShortDateString()</span>
                            <span> - @currentCourse.EndDate.ToShortDateString()</span>
                        </div>
                    </div>
                }
            </div>
            
            <div class="flex-shrink-0">
                <button class="btn btn-outline-primary" @onclick="OpenEditCourseDialog">
                    <i class="bi bi-pencil"></i>
                    <span class="d-none d-md-inline ms-1">Redigera kurs</span>
                </button>
            </div>
        </div>
    </div>

   <CourseNavigation CourseId="@CourseId"
                     ActiveTab="@activeTab"
                     ContentTab="@lastContentTab" />

    <div class="tab-content">
       @if (isLoading)
        {
            <div class="alert alert-info">Laddar kursdetaljer...</div>
        }
        else if (!string.IsNullOrWhiteSpace(loadError))
        {
            <div class="alert alert-danger" role="alert">@loadError</div>
        }
        else if (currentCourse is not null)
        {

            @switch (activeTab)
            {
                case "modules":
                    <ModuleList CourseId="CourseId" CurrentCourse="currentCourse" />
                    break;
                case "submissions":
                    <TeacherSubmissions CourseId="CourseId" />
                    break;
                case "students":
                    <StudentList CourseId="CourseId" />
                    break;
                case "documents":
                    <TeacherDocuments CourseId="@CourseId"
                                      IsEmbedded="true" />
                    break;
            }
        }
    </div>
</div>

<EditCourseDialog IsOpen="isModalOpen"
    CourseEditModel="courseToEdit"
    OnCourseUpdated="HandleCourseUpdated"
    OnClose="CloseModal" />

@code {
    [Parameter]
    public int CourseId { get; set; }

    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    private int _loadedCourseId;
    private CourseDto? currentCourse;
    private string? loadError;
    private bool isLoading = true;
    private string activeTab = "modules";
    private string lastContentTab = "modules";

    // For Edit Course Modal
    private bool isModalOpen = false;
    private CourseCreateDto? courseToEdit = null;

    protected override async Task OnParametersSetAsync()
    {
        activeTab = Tab?.ToLowerInvariant() switch
        {
            "documents" => "documents",
            "submissions" => "submissions",
            "students" => "students",
            _ => "modules"
        };

        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        bool courseChanged = CourseId != _loadedCourseId;

        if (courseChanged)
        {
            lastContentTab = "modules";
            CloseModal();
        }

        if (activeTab is "modules" or "documents")
        {
            lastContentTab = activeTab;
        }

        if (courseChanged)
        {
            _loadedCourseId = CourseId;
            await LoadCourseAsync();
        }
    }

    private async Task LoadCourseAsync()
    {
        isLoading = true;
        loadError = null;
        currentCourse = null;

        try
        {
            currentCourse = await ApiProxy.GetAsync<CourseDto>(
                $"courses/{CourseId}");

            if (currentCourse is null)
            {
                loadError = "Servern returnerade ingen kurs.";
            }
        }
        catch (UnauthorizedAccessException)
        {
            loadError = "Din session har gått ut. Logga in igen.";
        }
        catch (HttpRequestException ex)
            when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            loadError = "Kursen kunde inte hittas.";
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Could not load course {CourseId}: {ex}");
            loadError = "Kursen kunde inte hämtas. Försök igen.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenEditCourseDialog()
    {
        if (currentCourse == null)
        {
            ToastService.ShowToast("Ingen tillgänglig kurs för redigering.", ToastType.Danger);
            return; // Safety check
        }
        courseToEdit = new CourseCreateDto
        {
            Id = currentCourse.Id,
            Name = currentCourse.Name,
            Description = currentCourse.Description,
            StartDate = currentCourse.StartDate,
            EndDate = currentCourse.EndDate
        };
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
        courseToEdit = null;
    }

    private async Task HandleCourseUpdated()
    {
        CloseModal();
        await LoadCourseAsync(); // Refresh list after update
    }
}