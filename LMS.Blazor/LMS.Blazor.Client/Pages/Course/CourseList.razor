@page "/teacher/courses"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Logging
@using LMS.Shared.Constants
@using LMS.Shared.DTOs.CourseDtos
@using LMS.Blazor.Client.Services
@using LMS.Blazor.Client.Components.Courses
@using LMS.Blazor.Client.Components.Common
@using LMS.Blazor.Client.Services.ApiProxy
@attribute [Authorize(Roles = UserRoles.Teacher)]
@inject NavigationManager NavManager
@inject IApiProxyClient ApiProxy
@inject ToastService ToastService
@inject ILogger<CourseList> Logger

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">Alla kurser</h2>
            <p class="text-muted mb-0">En översikt över alla aktiva och kommande kurser</p>
        </div>
        <button class="btn btn-primary d-flex align-items-center gap-2 shadow-sm" @onclick="NavToCreateCourse">
            <i class="bi bi-plus-lg"></i> Ny kurs
        </button>
    </div>

    <!-- Search Bar & Filter Controls -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" 
                       class="form-control border-start-0 ps-0 shadow-none" 
                       placeholder="Sök efter kurs..." 
                       @bind="searchTerm" 
                       @bind:event="oninput" />
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <button class="btn btn-outline-secondary border-start-0" type="button" @onclick="ClearSearch">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Courses Table Card -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7 text-secondary">
                        <tr>
                            <th class="py-3 ps-4">Kursnamn</th>
                            <th class="py-3">Period</th>
                            <th class="py-3 text-center">Elever</th>
                            <th class="py-3 text-center">Moduler</th>
                            <th class="py-3 text-end pe-4">Åtgärder</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!string.IsNullOrWhiteSpace(loadError))
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-danger" role="alert">
                                    @loadError
                                </td>
                            </tr>
                        }
                        else if (filteredCourses is not { } loadedCourses)
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <div class="spinner-border spinner-border-sm text-primary me-2"
                                        role="status"></div>
                                    Laddar kurser...
                                </td>
                            </tr>
                        }
                        else if (!loadedCourses.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    Inga kurser hittades.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var course in loadedCourses)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-dark">
                                        @course.Name
                                    </td>

                                    <td class="text-secondary small">
                                        <i class="bi bi-calendar3 me-1 text-primary"></i>
                                        @course.StartDate.ToString("yyyy-MM-dd") — @course.EndDate.ToString("yyyy-MM-dd")
                                    </td>

                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border px-2 py-1">
                                            <i class="bi bi-people me-1 text-muted"></i> @course.StudentCount
                                        </span>
                                    </td>

                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border px-2 py-1">
                                            <i class="bi bi-journal-text me-1 text-muted"></i> @course.ModuleCount
                                        </span>
                                    </td>

                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm gap-2" role="group">
                                            <button class="btn btn-outline-secondary" title="Visa detaljer" @onclick="() => ViewCourse(course.Id)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <button class="btn btn-outline-primary" title="Redigera kurs" @onclick="() => OpenEditCourseDialog(course)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-outline-danger" title="Radera kurs" disabled="@isBusy" @onclick="() => PromptDeleteCourse(course.Id, course.Name)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<EditCourseDialog IsOpen="isModalOpen"
    CourseEditModel="courseToEdit"
    OnCourseUpdated="HandleCourseUpdated"
    OnClose="CloseModal" />

<ConfirmDialog IsOpen="showDeleteModal"
               Title="@($"TA BORT KURS: {courseToDeleteName}")"
               Message="Är du säker på att du vill ta bort denna kurs?
Studenter som är registrerade på kursen kommer att avregistreras.
Moduler som är kopplade till denna kurs kommer också att raderas. 
Aktiviteter som är kopplade till modulerna kommer också att raderas.
Dokument som är kopplade till kursen, moduler och aktiviteter kommer också att raderas.
Denna åtgärd går inte att ångra."
               ConfirmButtonText="Ta bort"
               ConfirmButtonClass="btn-danger"
               OnCancel="CloseDeleteModal"
               OnConfirm="ConfirmDeleteAsync" />

@code {
    private IEnumerable<CourseDto>? courses;
    private string searchTerm = string.Empty;
    private string? loadError;

    // For Edit Course Modal
    private bool isModalOpen = false;
    private CourseCreateDto? courseToEdit = null;

    // For Delete Course Modal
    private bool showDeleteModal = false;
    private bool isBusy = false;
    private int? courseToDeleteId = null;
    private string? courseToDeleteName = null;

    // Filter logic based on search input
    private IEnumerable<CourseDto>? filteredCourses => string.IsNullOrWhiteSpace(searchTerm)
        ? courses
        : courses?.Where(c => c.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                             (c.Description != null && c.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        await LoadCoursesAsync();
    }

    private async Task LoadCoursesAsync()
    {
        courses = null;
        loadError = null;

        try
        {
            courses = await ApiProxy.GetAsync<IEnumerable<CourseDto>>(
                "courses/with-counts") ?? Enumerable.Empty<CourseDto>();
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "The session expired while loading courses.");
            loadError = "Din session har gått ut. Logga in igen.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load courses.");
            loadError = "Kunde inte ladda kurser. Försök igen.";
        }
    }

    private void ClearSearch() => searchTerm = string.Empty;

    private void ViewCourse(int id)
    {
        NavManager.NavigateTo($"/teacher/courses/{id}");
    }

    private void NavToCreateCourse()
    {
        NavManager.NavigateTo("/teacher/courses/create");
    }

    private void OpenEditCourseDialog(CourseDto course)
    {
        courseToEdit = new CourseCreateDto
        {
            Id = course.Id,
            Name = course.Name,
            Description = course.Description,
            StartDate = course.StartDate,
            EndDate = course.EndDate
        };
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
        courseToEdit = null;
    }

    private async Task HandleCourseUpdated()
    {
        CloseModal();
        await LoadCoursesAsync(); // Refresh list after update
    }

    private void PromptDeleteCourse(int courseId, string courseName)
    {
        courseToDeleteId = courseId;
        courseToDeleteName = courseName;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        courseToDeleteId = null;
        courseToDeleteName = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (isBusy || courseToDeleteId == null) 
            return;

        isBusy = true;

        try
        {
            var (_, errorMessage) =
                await ApiProxy.SendAndHandleErrorAsync<object>(
                    HttpMethod.Delete,
                    $"courses/{courseToDeleteId.Value}");

            if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                Logger.LogWarning(
                    "The API rejected deletion of course {CourseId}: {ErrorMessage}",
                    courseToDeleteId,
                    errorMessage);

                ToastService.ShowToast(
                    "Kursen kunde inte raderas. Försök igen.",
                    ToastType.Danger);

                return;
            }

            ToastService.ShowToast($"Kursen {courseToDeleteName} har raderats.", ToastType.Success);
            CloseDeleteModal();
            await LoadCoursesAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "The session expired while deleting a course.");
            ToastService.ShowToast("Din session har gått ut. Vänligen logga in och försök igen.", ToastType.Danger);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not confirm deletion of course {CourseId}.",
            courseToDeleteId);

            ToastService.ShowToast($"Kursen kunde inte raderas. " +
            "Ladda om kurslistan innan du försöker igen.", ToastType.Danger);
        }
        finally
        {
            isBusy = false;
        }
    }
}