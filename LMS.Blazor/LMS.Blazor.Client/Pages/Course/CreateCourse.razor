@page "/teacher/courses/create"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Logging
@using LMS.Shared.Constants
@using LMS.Shared.DTOs.CourseDtos
@using LMS.Blazor.Client.Services
@using LMS.Blazor.Client.Components.Courses
@using LMS.Blazor.Client.Services.ApiProxy
@attribute [Authorize(Roles = UserRoles.Teacher)]
@inject NavigationManager NavManager
@inject IApiProxyClient ApiProxy
@inject ILogger<CreateCourse> Logger
@inject ToastService ToastService

<div class="container my-4">
    <div class="col-lg-6">
        <h3>Skapa ny kurs</h3>
        <p class="text-muted mb-4">Fyll i uppgifterna nedan för att registrera en ny kurs.</p>

        <div class="card shadow-sm">
            <div class="card-body">
@if (!string.IsNullOrWhiteSpace(formError))
                {
                    <div class="alert alert-danger" role="alert">
                        @formError
                    </div>
                }

                <CourseForm Model="courseModel"
                OnSaveCourse="SaveCourse"
                OnCancel="Cancel"
                SubmitButtonText="Skapa kurs"
                IsBusy="isSubmitting" />
            </div>
        </div>
    </div>
</div>

@code {
    private CourseCreateDto courseModel = new();
    private bool isSubmitting = false;
    private string? formError;

    void Cancel()
    {
        NavManager.NavigateTo($"/teacher/courses");
    }

    private async Task SaveCourse()
    {
        if (isSubmitting)
            return;

        formError = null;

        if (string.IsNullOrWhiteSpace(courseModel.Name) ||
            courseModel.Name.Trim().Length > CourseConstraints.NameMaxLength)
        {
            formError = "Registrera ett kursnamn mellan 1 och " +
            $"{CourseConstraints.NameMaxLength} tecken.";
            return;
        }

        if (courseModel.StartDate > courseModel.EndDate)
        {
            formError = "Startdatum får inte ligga efter slutdatum.";
            return;
        }

        if ((courseModel.Description?.Length ?? 0) >
            CourseConstraints.DescriptionMaxLength)
        {
            formError = "Beskrivningen får innehålla högst " +
            $"{CourseConstraints.DescriptionMaxLength} tecken.";
            return;
        }


        isSubmitting = true;
        try
        {
            courseModel.Name = courseModel.Name.Trim();

            var (createdCourse, errorMessage) =
                await ApiProxy.SendAndHandleErrorAsync<CourseDto>(
                    HttpMethod.Post,
                    "courses",
                    JsonContent.Create(courseModel));

            if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                Logger.LogWarning(
                    "The API rejected course creation: {ErrorMessage}",
                    errorMessage);

                formError = errorMessage switch
                {
                    "A course with this name already exists." =>
                    "Det finns redan en kurs med det namnet.",

                    _ =>
                    "Kursen kunde inte skapas. Kontrollera uppgifterna och försök igen."
                };

                return;
            }


            if (createdCourse is null)
            {
                formError = "Kursen kunde inte skapas. Vänligen försök igen.";
                return;
            }

                ToastService.ShowToast(
                    $"Kursen {createdCourse.Name} har skapats.", ToastType.Success);
            }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "The session expired while creating a course.");
            formError = "Din session har gått ut. Logga in igen.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "The course creation request failed.");
            formError = "Kursen kunde inte skapas." +
            "Kontrollera uppgifterna innan du försöker igen.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
}