@page "/teacher/courses/{CourseId:int}/modules"

@using Microsoft.AspNetCore.Authorization
@using LMS.Blazor.Client.Services
@using LMS.Shared.DTOs.CourseDtos
@using LMS.Shared.DTOs.ModulesDtos
@using LMS.Blazor.Client.Pages.Modules.Components
@using LMS.Shared.Constants
@attribute [Authorize(Roles = UserRoles.Teacher)]
@inject ICourseService CourseService
@inject IModuleService ModuleService

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Moduler</h3>

        <button class="btn btn-primary" @onclick="OpenAddModuleModal">
            <i class="bi bi-plus-circle me-1"></i> Lägga till Modul
        </button>
    </div>

    @if (isLoading)
    {
        <p class="text-muted">Laddar moduler...</p>
    }
    else if (modules == null || !modules.Any())
    {
        <div class="alert alert-info">Inga moduler hittades för denna kurs.</div>
    }
    else
    {
        <div class="row row-cols-1 g-3">
            @foreach (var module in modules)
            {
                <div class="col">
                    <div class="card shadow-sm p-3">
                        <div class="row align-items-center">
                        
                            <div class="col-auto text-center" style="font-size: 2.5rem;">
                                📚
                            </div>

                            <div class="col">
                                <h5 class="mb-1 fw-bold">@module.Name</h5>
                                <div class="text-muted small">
                                    <span>Start: @module.StartDate.ToShortDateString()</span> | 
                                    <span>Slut: @module.EndDate.ToShortDateString()</span>
                                </div>
                                <div class="small text-secondary mt-1">@module.Description</div>
                            </div>

                            <div class="col-auto">
                                <a href="teacher/modules/@module.Id/activities" class="btn btn-outline-primary btn-sm">
                                    Aktiviteter
                                </a>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => EditModule(module.Id)">
                                    Redigera
                                </button>
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteModule(module.Id)">
                                    Ta bort
                                </button>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>

<AddModuleDialog IsOpen="showAddModal"
                 CourseId="CourseId"
                 CurrentCourse="currentCourse"
                 ModuleService="ModuleService"
                 OnClose="() => showAddModal = false"
                 OnModuleCreated="LoadModulesAsync" />

@code {
    [Parameter]
    public int CourseId { get; set; }
    private CourseDto? currentCourse;
    private IEnumerable<ModuleDto> modules = new List<ModuleDto>();
    private bool isLoading = true;
    private bool showAddModal = false;

    protected override async Task OnInitializedAsync()
    {
        currentCourse = await CourseService.GetCourseByIdAsync(CourseId);
        await LoadModulesAsync();
    }

    private async Task LoadModulesAsync()
    {
        isLoading = true;
        try
        {
            modules = await ModuleService.GetModulesByCourseIdAsync(CourseId);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenAddModuleModal()
    {
        showAddModal = true;
    }

    private void EditModule(int moduleId)
    {
        // Placeholder for editing module logic
    }

    private void DeleteModule(int moduleId)
    {
        // Placeholder for deleting module logic
    }
}