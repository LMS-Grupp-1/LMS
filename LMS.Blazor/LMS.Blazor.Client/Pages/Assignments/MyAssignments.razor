@page "/assignments"
@attribute [Authorize(Roles = UserRoles.Student)]
@implements IDisposable

@using System.Globalization
@using System.Net
@using Microsoft.AspNetCore.Authorization
@using LMS.Blazor.Client.Services
@using LMS.Shared.Constants
@using LMS.Shared.DTOs.AssignmentDtos
@using Microsoft.AspNetCore.Components.Forms
@using LMS.Blazor.Client.Helpers
@using LMS.Blazor.Client.Components.Feedbacks

@inject IAssignmentService AssignmentService
@inject NavigationManager NavigationManager

<PageTitle>Mina uppgifter</PageTitle>

<h1 class="h3 fw-bold mb-4">Mina uppgifter</h1>

@if (isLoading)
{
    <div class="d-flex align-items-center gap-2 text-muted">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span>Hämtar uppgifter...</span>
    </div>
}
else if (errorMessage is not null)
{
    <div class="alert alert-warning">@errorMessage</div>
}
else if (assignments.Count == 0)
{
    <div class="text-muted">Det finns inga uppgifter i din kurs ännu.</div>
}
else
{
    <div class="list-group">
        @foreach (var assignment in assignments)
        {
            var (statusText, statusClass) = AssignmentStatusDisplay.For(assignment.Status);
            var isExpanded = expandedId == assignment.Id;

            <div class="list-group-item">
                @* The whole row toggles the details, which is the detail view of the assignment *@
                <button type="button"
                        class="btn btn-link text-start text-decoration-none text-body w-100 p-0"
                        aria-expanded="@isExpanded"
                        @onclick="() => ToggleDetails(assignment.Id)">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <div class="fw-semibold">@assignment.Name</div>
                            <small class="text-muted">@assignment.ModuleName</small>
                        </div>
                        <div class="text-end flex-shrink-0">
                            <span class="badge @statusClass">@statusText</span>
                            @if (assignment.HasFeedback)
                            {
                                <i class="bi bi-chat-left-text ms-1" title="Feedback finns"></i>
                            }
                            <div>
                                <small class="text-muted">
                                    @(assignment.Deadline is { } deadline
                                        ? $"Deadline {deadline.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)}"
                                        : "Ingen deadline")
                                </small>
                            </div>
                        </div>
                    </div>
                </button>

                @if (isExpanded)
                {
                    <div class="mt-3 pt-3 border-top">
                        <p class="mb-2" style="white-space: pre-line;">
                            @(string.IsNullOrWhiteSpace(assignment.Description)
                                ? "Ingen beskrivning."
                                : assignment.Description)
                        </p>

                        @if (assignment.SubmittedAt is { } submittedAt)
                        {
                            <small class="text-muted d-block">
                                <i class="bi bi-check2-circle"></i>
                                Inlämnad @submittedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)
                            </small>
                        }

                        @if (assignment.HasFeedback)
                        {
                            <a href="javascript:void(0);" 
                               class="text-decoration-none d-flex align-items-center gap-1 text-primary small mt-1" 
                               @onclick="() => OpenStudentFeedbackModal(assignment)">
                                <i class="bi bi-chat-left-text-fill"></i>
                                <span>Läraren har lämnat feedback på din inlämning.</span>
                            </a>
                        }
                        
                        @if (assignment.RequiresSubmission)
                        {
                            <div class="mt-3">
                                <label class="form-label small fw-semibold" for="file-@assignment.Id">
                                    @(assignment.SubmittedAt is null ? "Lämna in" : "Lämna in en ny version")
                                </label>
                                <div class="d-flex flex-wrap gap-2">
                                    <InputFile @key="fileInputKey"
                                               id="@($"file-{assignment.Id}")"
                                               class="form-control form-control-sm"
                                               style="max-width: 24rem;"
                                               accept="@AcceptedFileTypes"
                                               OnChange="SelectFile"
                                               disabled="@isSubmitting" />
                                    <button type="button"
                                            class="btn btn-primary btn-sm"
                                            disabled="@(selectedFile is null || isSubmitting)"
                                            @onclick="() => SubmitAsync(assignment.Id)">
                                        @if (isSubmitting)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                        }
                                        Lämna in
                                    </button>
                                </div>

                                @if (submitError is not null)
                                {
                                    <div class="text-danger small mt-2">@submitError</div>
                                }
                                @if (submitSuccess is not null)
                                {
                                    <div class="text-success small mt-2">@submitSuccess</div>
                                }
                            </div>
                        }

                    </div>
                }
            </div>
        }
    </div>
}

<StudentFeedbackListDialog IsOpen="isModalOpen"
                 Assignment="selectedAssignment"
                 OnClose="CloseModal" />

@code {
    private List<StudentAssignmentDto> assignments = [];
    private bool isLoading = true;
    private string? errorMessage;
    private int? expandedId;
    private readonly CancellationTokenSource componentCancellation = new();

    // Feedback
    private bool isModalOpen = false;
    private StudentAssignmentDto? selectedAssignment;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await AssignmentService.GetMyAssignmentsAsync(componentCancellation.Token);

            // The server-side prerender service deliberately returns null.
            // Keep showing the loading state until WebAssembly runs this again.
            if (result is null)
            {
                return;
            }

            assignments = result.ToList();
            isLoading = false;
        }
        catch (OperationCanceledException) when (componentCancellation.IsCancellationRequested)
        {
            // Navigating away disposes the component and cancels its request.
        }
        catch (UnauthorizedAccessException)
        {
            // The session has expired, send the user to the login page
            NavigationManager.NavigateTo(
                $"Account/Login?returnUrl={Uri.EscapeDataString(NavigationManager.Uri)}",
                forceLoad: true);
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            // The API returns 404 when the student is not enrolled in a course
            errorMessage = "Du är inte kopplad till någon kurs ännu.";
            isLoading = false;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Uppgifterna kunde inte hämtas. Försök igen senare.";
            isLoading = false;
        }
    }

    // Only one assignment is expanded at a time; clicking it again collapses it.
    private void ToggleDetails(int assignmentId)
    {
        expandedId = expandedId == assignmentId ? null : assignmentId;
        selectedFile = null;
        submitError = null;
        submitSuccess = null;
        fileInputKey = Guid.NewGuid();
    }

    // Only the file types the API accepts can be selected, for example ".pdf,.docx".
    private static readonly string AcceptedFileTypes =
        string.Join(",", DocumentConstraints.ContentTypes.Keys);

    private IBrowserFile? selectedFile;
    private bool isSubmitting;
    private string? submitError;
    private string? submitSuccess;

    // Changing the key recreates InputFile, which clears the selected file after a submission.
    private Guid fileInputKey = Guid.NewGuid();

    private void SelectFile(InputFileChangeEventArgs args)
    {
        selectedFile = args.File;
        submitError = null;
        submitSuccess = null;

        if (selectedFile.Size > DocumentConstraints.MaxFileSize)
        {
            submitError = $"Filen är för stor. Max {DocumentConstraints.MaxFileSize / (1024 * 1024)} MB.";
            selectedFile = null;
        }
    }

    private async Task SubmitAsync(int assignmentId)
    {
        if (selectedFile is null) return;

        isSubmitting = true;
        submitError = null;
        submitSuccess = null;

        try
        {
            var (updated, error) = await AssignmentService.SubmitAsync(
                assignmentId, selectedFile, componentCancellation.Token);

            if (updated is null)
            {
                submitError = string.IsNullOrWhiteSpace(error) ? "Inlämningen misslyckades. Försök igen." : error;
                return;
            }

            // Replace the row, so the new status and time are shown without reloading the list.
            var index = assignments.FindIndex(item => item.Id == assignmentId);
            if (index >= 0)
            {
                assignments[index] = updated;
            }

            submitSuccess = "Din fil är inlämnad.";
            selectedFile = null;
            fileInputKey = Guid.NewGuid();
        }
        catch (IOException)
        {
            // OpenReadStream throws if the file is larger than the allowed size.
            submitError = "Filen kunde inte läsas. Kontrollera att den inte är för stor.";
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo(
                $"Account/Login?returnUrl={Uri.EscapeDataString(NavigationManager.Uri)}",
                forceLoad: true);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    public void Dispose()
    {
        componentCancellation.Cancel();
        componentCancellation.Dispose();
    }

    // Feedback
    private void OpenStudentFeedbackModal(StudentAssignmentDto assignment)
    {
        selectedAssignment = assignment;
        isModalOpen = true;
    }
    
    private async Task CloseModal()
    {
        isModalOpen = false;
        selectedAssignment = null;
    }
}