@implements IDisposable

@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <h3 class="fw-bold text-black">
                <i class="bi bi-book text-primary"></i>
                Lexicon LMS
            </h3>
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    
    <nav class="nav flex-column">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <h4 class="m-1"><i class="bi bi-house-door"></i></h4>
                        Dashboard
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Teacher">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="counter">
                        <h4 class="m-1"><i class="bi bi-book"></i></h4>
                        Kurser
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="auth">
                        <h4 class="m-1"><i class="bi bi-plus-circle"></i></h4>
                        Skapa Ny Kurs
                    </NavLink>
                </div>
        
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="users">
                        <h4 class="m-1"><i class="bi bi-people"></i></h4>
                        Användare
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="other">
                        <h4 class="m-1"><i class="bi bi-list-ul"></i></h4>
                        Inlämningar
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        
        <AuthorizeView Roles="Student">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="my_course">
                        <h4 class="m-1"><i class="bi bi-book"></i></h4>
                        Min Kurs
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="submissions">
                        <h4 class="m-1"><i class="bi bi-file-earmark-text"></i></h4>
                        Inlämningar
                    </NavLink>
                </div>
        
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Students">
                        <h4 class="m-1"><i class="bi bi-people"></i></h4>
                        Kursdeltagare
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

