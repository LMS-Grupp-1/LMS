
@using LMS.Blazor.Client.Components.Notifications

<div class="top-row px-4 bg-white border-bottom d-flex align-items-center justify-content-end">
    <AuthorizeView>
        <!-- Notification Bell with Dropdown Dialog -->
        <div class="position-relative d-inline-block me-2">
            <button class="btn position-relative" @onclick="ToggleNotifications">
                <i class="bi bi-bell"></i>
                @if (unreadCount > 0)
                {
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">
                            @(unreadCount > 9 ? "9+" : unreadCount.ToString())
                    </span>
                }
            </button>

            <NotificationBellDialog IsOpen="isNotificationOpen" 
                    IsOpenChanged="((bool value) => isNotificationOpen = value)" 
                    OnUnreadCountChanged="HandleUnreadCountChanged" />
        </div>

        <button class="btn">
            <i class="@(context.User.IsInRole("Student") ? "bi bi-person-circle" : "bi bi-person-vcard")"></i> 
            @context.User.Identity?.Name
        </button>
        
        <div class="nav-item px-3">
            <form action="Account/Logout" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="" />
                <button type="submit" class="nav-link">
                    <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span>
                    <i class="bi bi-box-arrow-in-right"></i> Logout
                </button>
            </form>
        </div>
    </AuthorizeView>
</div>

@code {
    private bool isNotificationOpen = false;
    private int unreadCount = 0;

    private void ToggleNotifications()
    {
        isNotificationOpen = !isNotificationOpen;
    }

    private void HandleUnreadCountChanged(int count)
    {
        unreadCount = count;
        StateHasChanged();
    }
}