@using System.Globalization
@using LMS.Blazor.Client.Components.Assignments
@using LMS.Blazor.Client.Helpers
@using LMS.Blazor.Client.Services
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Blazor.Client.ViewModels.Modules
@using LMS.Shared.DTOs.ActivityDtos
@using LMS.Shared.DTOs.AssignmentDtos
@inject IApiProxyClient ApiProxy
@inject ToastService ToastService

<div class="card shadow-sm">
    <div class="card-header bg-lignt d-flex justify-content-between align-items-center p-3">
        <h5 class="mb-0 fw-bold">AKTIVITETER</h5>
        <button class="btn btn-primary btn-sm" @onclick="OpenAddActivityModal">
            <i class="bi bi-plus-lg"></i>
            <span class="d-none d-md-inline ms-1">Lägg till aktivitet</span>
        </button>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-warning">@errorMessage</div>
    }

    <div class="card-body bg-light px-0">
        @if (isLoading)
        {
            <p class="text-muted px-2 mb-0">Ladda aktiviterer...</p>
        }
        else if (!activities.Any())
        {
            <p class="text-muted px-2 mb-0">Inga aktiviteter tillgängliga.</p>
        }
        else
        {
            @foreach (var activity in activities)
            {
                <div class="card mb-3 shadow-sm border-0">
                    <div class="card-header bg-white p-3">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                            <div>
                                <div class="d-flex align-items-center mb-2 flex-wrap gap-2">
                                    <span class="badge @ActivityTypeHelper.GetBadgeClass(activity.ActivityTypeId) px-3 py-2 rounded-pill fw-semibold">
                                        @ActivityTypeHelper.GetName(activity.ActivityTypeId)
                                    </span>
                                    <h6 class="mb-0 fw-semibold text-dark">@activity.Name</h6>
                                </div>

                                <div class="text-muted small">
                                    <div class="d-flex align-items-center mb-1">
                                        <i class="bi bi-calendar-event me-1 text-success"></i>
                                        <span>
                                            @activity.StartDate.ToString("yyyy-MM-dd HH:mm") - 
                                            @if (activity.StartDate.Date == activity.EndDate.Date)
                                            { @activity.EndDate.ToString("HH:mm") }
                                            else
                                            { @activity.EndDate.ToString("yyyy-MM-dd HH:mm") }
                                        </span>
                                    </div>
                                    <p class="mb-0 text-secondary">@activity.Description</p>
                                </div>
                            </div>

                            <div class="btn-group gap-2" role="group">
                                <button class="btn btn-outline-success btn-sm" @onclick="() => OpenAddAssignmentModal(activity.Id)">
                                    <i class="bi bi-journal-plus"></i>
                                    <span class="d-none d-md-inline ms-1">Lägg till uppgift</span>
                                </button>
                                <button class="btn btn-outline-primary btn-sm" @onclick="() => OpenEditActivityModal(activity)">
                                    <i class="bi bi-pencil"></i>
                                    <span class="d-none d-md-inline ms-1">Redigera aktivitet</span>
                                </button>
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteActivity(activity.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>

                        </div>
                    </div>
                    @{
                        var activityAssignments = assignmentsByActivity[activity.Id].ToList();
                    }
                    @if (activityAssignments.Any())
                    {
                        <ul class="list-group list-group-flush border-top">
                            @foreach (var assignment in activityAssignments)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2 px-3">
                                    <div>
                                        <i class="bi bi-journal-text me-1 text-primary"></i>
                                        <span class="fw-semibold">@assignment.Name</span>
                                        <span class="text-muted small ms-2">
                                            @(assignment.Deadline is { } deadline
                                                ? $"Deadline {deadline.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)}"
                                                : "Ingen deadline")
                                        </span>
                                        @if (!assignment.RequiresSubmission)
                                        {
                                            <span class="badge bg-secondary ms-2">Ingen inlämning</span>
                                        }
                                        @if (assignment.SubmissionCount > 0)
                                        {
                                            <span class="badge bg-info text-dark ms-2">@assignment.SubmissionCount inlämningar</span>
                                        }
                                    </div>
                                    <div class="btn-group gap-2">
                                        <button class="btn btn-outline-primary btn-sm" @onclick="() => OpenEditAssignmentModal(assignment)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        @* Assignments with submissions cannot be deleted (the API returns 409). *@
                                        @if (assignment.SubmissionCount == 0)
                                        {
                                            <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteAssignmentAsync(assignment)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            }
        }
    </div>
</div>

<!-- Unified Form Dialog for both Add and Edit -->
<ActivityFormDialog IsOpen="isModalOpen"
                 CurrentModule="CurrentModule"
                 ActivityToEdit="selectedActivity"
                 OnClose="CloseModal"
                 OnActivitySaved="HandleActivitySaved" />
                 
                 <AssignmentFormDialog IsOpen="isAssignmentModalOpen"
                      CurrentModule="CurrentModule"
                      Activities="activities"
                      SelectedActivityId="selectedActivityIdForAssignment"
                      AssignmentToEdit="selectedAssignment"
                      OnClose="CloseAssignmentModal"
                      OnSaved="HandleAssignmentSaved" />

@code {
    [Parameter] public ModuleViewModel CurrentModule { get; set; } = default!;

    private IEnumerable<ActivityDto> activities = new List<ActivityDto>();
    private bool isLoading = true;
    private string? errorMessage = null;

    private ActivityDto? selectedActivity = null; // null = Add mode, Has value = Edit mode
    private bool isModalOpen = false;

    // Assignments grouped by activity, so each activity card can show its own.
    private ILookup<int, TeacherAssignmentDto> assignmentsByActivity =
        Enumerable.Empty<TeacherAssignmentDto>().ToLookup(a => a.ActivityId);

    private bool isAssignmentModalOpen;
    private int selectedActivityIdForAssignment;
    private TeacherAssignmentDto? selectedAssignment; // null = create mode

    protected override async Task OnParametersSetAsync()
    {
        await LoadActivitiesAsync();
    }

    private async Task LoadActivitiesAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            activities = await ApiProxy.GetAsync<IEnumerable<ActivityDto>>(
                $"activities/in-module/{CurrentModule.Id}"
            ) ?? Enumerable.Empty<ActivityDto>();

            // One call per module, grouped by activity on the client.
            var assignments = await ApiProxy.GetAsync<IEnumerable<TeacherAssignmentDto>>(
                $"teacher/modules/{CurrentModule.Id}/assignments"
            ) ?? Enumerable.Empty<TeacherAssignmentDto>();
            assignmentsByActivity = assignments.ToLookup(a => a.ActivityId);
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Misslyckades med att ladda moduler: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void OpenAddActivityModal()
    {
        selectedActivity = null; // Clear out any previous edit state -> triggers Add Mode
        isModalOpen = true;
    }

    private void OpenEditActivityModal(ActivityDto activity)
    {
        selectedActivity = activity;

        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
        selectedActivity = null;
    }

    private async Task HandleActivitySaved()
    {
        CloseModal();
        await LoadActivitiesAsync();
    }

    private void DeleteActivity(int id) { /* Mock action */ }

    private void OpenAddAssignmentModal(int activityId)
    {
        selectedAssignment = null;
        selectedActivityIdForAssignment = activityId;
        isAssignmentModalOpen = true;
    }

    private void OpenEditAssignmentModal(TeacherAssignmentDto assignment)
    {
        selectedAssignment = assignment;
        isAssignmentModalOpen = true;
    }

    private void CloseAssignmentModal()
    {
        isAssignmentModalOpen = false;
        selectedAssignment = null;
    }

    private async Task HandleAssignmentSaved()
    {
        CloseAssignmentModal();
        await LoadActivitiesAsync();
    }

    private async Task DeleteAssignmentAsync(TeacherAssignmentDto assignment)
    {
        var (_, error) = await ApiProxy.SendAndHandleErrorAsync<bool>(
            HttpMethod.Delete, $"teacher/assignments/{assignment.Id}");

        if (!string.IsNullOrWhiteSpace(error))
        {
            ToastService.ShowToast($"Det gick inte att ta bort uppgiften. {error}", ToastType.Danger);
            return;
        }

        ToastService.ShowToast($"Uppgiften {assignment.Name} har tagits bort.", ToastType.Success);
        await LoadActivitiesAsync();
    }
}