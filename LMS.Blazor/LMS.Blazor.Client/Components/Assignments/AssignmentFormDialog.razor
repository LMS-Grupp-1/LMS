@using System.Net.Http.Json
@using LMS.Blazor.Client.Services
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Blazor.Client.ViewModels.Modules
@using LMS.Shared.DTOs.ActivityDtos
@using LMS.Shared.DTOs.AssignmentDtos
@inject IApiProxyClient ApiProxy
@inject ToastService ToastService

@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <EditForm Model="model" OnValidSubmit="HandleSubmitAsync">
                    <DataAnnotationsValidator />

                    <div class="modal-header">
                        <h5 class="modal-title">@(IsEditMode ? "Redigera uppgift" : "Lägg till uppgift")</h5>
                        <button type="button" class="btn-close" @onclick="Close"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Aktivitet <span class="text-danger">*</span></label>
                            @* Only activities in the current module, so moving stays inside the module. *@
                            <InputSelect class="form-select" @bind-Value="model.ActivityId">
                                @foreach (var activity in Activities)
                                {
                                    <option value="@activity.Id">@activity.Name (@activity.StartDate.ToString("yyyy-MM-dd"))</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => model.ActivityId" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Namn <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="model.Name" />
                            <ValidationMessage For="() => model.Name" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Beskrivning</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="model.Description" />
                            <ValidationMessage For="() => model.Description" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Deadline</label>
                                @* Empty field means no deadline. *@
                                <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="model.Deadline" />
                                <div class="form-text">Lämna tomt om uppgiften saknar deadline.</div>
                            </div>
                            <div class="col-md-6 mb-3 d-flex align-items-center">
                                <div class="form-check mt-md-3">
                                    <InputCheckbox id="requiresSubmission" class="form-check-input" @bind-Value="model.RequiresSubmission" />
                                    <label class="form-check-label" for="requiresSubmission">Kräver inlämning</label>
                                </div>
                            </div>
                        </div>

                        @if (DeadlineAfterModuleEnd)
                        {
                            @* Only a warning: the server allows it as long as the course has not ended. *@
                            <div class="alert alert-warning mb-0">
                                Deadline ligger efter modulens slutdatum (@CurrentModule.EndDate.ToString("yyyy-MM-dd")).
                                Eleverna kan ha gått vidare till nästa modul.
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(submitErrorMessage))
                        {
                            <div class="alert alert-danger mt-3 mb-0">@submitErrorMessage</div>
                        }
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="Close">Avbryt</button>
                        <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            @(IsEditMode ? "Spara ändringar" : "Skapa")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public ModuleViewModel CurrentModule { get; set; } = default!;

    // The activities in the module, used for the dropdown.
    [Parameter] public IEnumerable<ActivityDto> Activities { get; set; } = [];

    // The activity the teacher clicked "Lägg till uppgift" on. Used in create mode.
    [Parameter] public int SelectedActivityId { get; set; }

    // Null = create mode, a value = edit mode.
    [Parameter] public TeacherAssignmentDto? AssignmentToEdit { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private AssignmentFormDto model = new();
    private bool isSubmitting;
    private string? submitErrorMessage;
    private bool wasOpen;

    private bool IsEditMode => AssignmentToEdit is not null;

    // Compare dates only, the same way as the server compares against the course end date.
    private bool DeadlineAfterModuleEnd =>
        model.Deadline.HasValue && model.Deadline.Value.Date > CurrentModule.EndDate.Date;

    protected override void OnParametersSet()
    {
        // Fill the form only when the dialog opens, so a re-render does not wipe what the teacher typed.
        if (IsOpen && !wasOpen)
        {
            isSubmitting = false;
            submitErrorMessage = null;

            model = AssignmentToEdit is { } assignment
                ? new AssignmentFormDto
                {
                    ActivityId = assignment.ActivityId,
                    Name = assignment.Name,
                    Description = assignment.Description,
                    Deadline = assignment.Deadline,
                    RequiresSubmission = assignment.RequiresSubmission
                }
                : new AssignmentFormDto { ActivityId = SelectedActivityId };
        }

        wasOpen = IsOpen;
    }

    private async Task Close() => await OnClose.InvokeAsync();

    private async Task HandleSubmitAsync()
    {
        isSubmitting = true;
        submitErrorMessage = null;

        using var content = JsonContent.Create(model);

        var (method, endpoint, verb) = IsEditMode
            ? (HttpMethod.Put, $"teacher/assignments/{AssignmentToEdit!.Id}", "uppdatera")
            : (HttpMethod.Post, "teacher/assignments", "skapa");

        var (_, error) = await ApiProxy.SendAndHandleErrorAsync<bool>(method, endpoint, content);

        isSubmitting = false;

        if (!string.IsNullOrWhiteSpace(error))
        {
            submitErrorMessage = $"Det gick inte att {verb} uppgiften. {error}";
            return;
        }

        ToastService.ShowToast(
            $"Uppgiften {model.Name} har {(IsEditMode ? "ändrats" : "skapats")}.",
            ToastType.Success);

        await OnSaved.InvokeAsync();
    }
}