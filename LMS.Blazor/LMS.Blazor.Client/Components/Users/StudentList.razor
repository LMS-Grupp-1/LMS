@using LMS.Shared.DTOs.CourseDtos
@using LMS.Shared.DTOs.Users
@using LMS.Blazor.Client.ViewModels
@using LMS.Blazor.Client.Services.ApiProxy
@inject NavigationManager Navigation
@inject IApiProxyClient ApiProxy

<div class="container-fluid px-0">
@if (!string.IsNullOrEmpty(errorMsg))
{
    <div class="text-danger my-2">
        <i class="bi bi-exclamation-circle me-1"></i> @errorMsg
    </div>
}
@if (users == null)
{
    <h3 class="mb-3">Registrerade studenter</h3>
    <p><em>Laddar studenter...</em></p>
}
else if (!users.Any())
{
    <h3 class="mb-3">Registrerade studentere</h3>
    <p>Inga studenter registrerade på denna kurs.</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h5 class="fw-bold mb-1">Studenter</h5>
            <p class="text-muted small mb-0">Visa studenter som är registrerade på denna kurs.</p>
        </div>
        <button class="btn btn-primary" @onclick="NavigeraToCreateUserForCourse">
            <i class="bi bi-plus-circle me-1"></i> Lägg till student
        </button>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Förnamn</th>
                <th>Efternamn</th>
                <th>E-post</th>
                <th>Åtgärder</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in users)
            {
                <tr>
                    <td>@user.FirstName</td>
                    <td>@user.LastName</td>
                    <td>@user.Email</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditUser(user.Id)">
                            <i class="bi bi-pencil"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>   
}
</div>

@code {
    [Parameter] public int CourseId { get; set; }

    private IEnumerable<UserDto>? users;
    private string? errorMsg = null;

    protected override async Task OnParametersSetAsync()
    {
        await LoadUsersByCourseIdAsync();
    }

    private async Task LoadUsersByCourseIdAsync()
    {
        try
        {
            users = await ApiProxy.GetAsync<IEnumerable<UserDto>>($"users/students/{CourseId}") ?? Enumerable.Empty<UserDto>();
        }
        catch (Exception ex)
        {
            errorMsg = $"Kunde inte ladda studenter: {ex.Message}";
            users = null;
        }


        StateHasChanged();
    }

    private void NavigeraToCreateUserForCourse()
    {
        var returnUrl = Uri.EscapeDataString($"/teacher/courses/{CourseId}?tab=students");
        Navigation.NavigateTo($"/users/create?returnUrl={returnUrl}");
    }

    private void EditUser(string id)
    {
        var returnUrl = Uri.EscapeDataString($"/teacher/courses/{CourseId}?tab=students");
        Navigation.NavigateTo($"/users/edit/{id}?returnUrl={returnUrl}");
    }
}