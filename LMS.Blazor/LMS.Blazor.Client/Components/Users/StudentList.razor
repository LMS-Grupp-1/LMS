@using LMS.Shared.DTOs.CourseDtos
@using LMS.Shared.DTOs.Users
@using LMS.Blazor.Client.ViewModels
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Blazor.Client.Components.Common
@inject NavigationManager Navigation
@inject IApiProxyClient ApiProxy

<div class="container-fluid px-0">
    <CourseSectionHeader Title="Studenter"
                         Description="Studenter som är registrerade på den här kursen.">
        <Actions>
            <button type="button"
                    class="btn btn-primary"
                    @onclick="NavigeraToCreateUserForCourse">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
                Lägg till student
            </button>
        </Actions>
    </CourseSectionHeader>

    @if (!string.IsNullOrWhiteSpace(errorMsg))
    {
        <div class="alert alert-danger" role="alert">
            @errorMsg
        </div>
    }
    else if (users is null)
    {
        <p class="text-muted" role="status">Laddar studenter...</p>
    }
    else if (!users.Any())
    {
        <div class="bg-white border rounded p-4 text-muted">
            Inga studenter är registrerade på den här kursen.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <caption class="visually-hidden">
                        Studenter registrerade på kursen
                    </caption>

                    <thead class="table-light text-secondary">
                        <tr>
                            <th scope="col" class="py-3 ps-4">Förnamn</th>
                            <th scope="col" class="py-3">Efternamn</th>
                            <th scope="col" class="py-3">E-post</th>
                            <th scope="col" class="py-3 text-end pe-4">
                                Åtgärder
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var user in users)
                        {
                            <tr @key="user.Id">
                                <td class="ps-4">@user.FirstName</td>
                                <td>@user.LastName</td>
                                <td>@user.Email</td>
                                <td class="text-end pe-4">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            aria-label="@($"Redigera {user.FirstName} {user.LastName}")"
                                            @onclick="() => EditUser(user.Id)">
                                        <i class="bi bi-pencil"
                                           aria-hidden="true"></i>
                                        <span class="ms-1">Redigera</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int CourseId { get; set; }

    private IEnumerable<UserDto>? users;
    private string? errorMsg = null;

    protected override async Task OnParametersSetAsync()
    {
        await LoadUsersByCourseIdAsync();
    }

    private async Task LoadUsersByCourseIdAsync()
    {
        try
        {
            users = await ApiProxy.GetAsync<IEnumerable<UserDto>>($"users/students/{CourseId}") ?? Enumerable.Empty<UserDto>();
        }
        catch (Exception ex)
        {
            errorMsg = $"Kunde inte ladda studenter: {ex.Message}";
            users = null;
        }


        StateHasChanged();
    }

    private void NavigeraToCreateUserForCourse()
    {
        var returnUrl = Uri.EscapeDataString($"/teacher/courses/{CourseId}?tab=students");
        Navigation.NavigateTo($"/users/create?returnUrl={returnUrl}");
    }

    private void EditUser(string id)
    {
        var returnUrl = Uri.EscapeDataString($"/teacher/courses/{CourseId}?tab=students");
        Navigation.NavigateTo($"/users/edit/{id}?returnUrl={returnUrl}");
    }
}