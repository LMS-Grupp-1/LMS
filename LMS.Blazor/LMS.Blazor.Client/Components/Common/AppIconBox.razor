@* <div class="@GetThemeClasses() rounded-3 d-flex align-items-center justify-content-center" 
     style="width: 48px; height: 48px; min-width: 48px;">
    <i class="bi @GetIconClass() fs-4"></i>
</div> *@
<div class="@GetCustomClasses()">
    <i class="bi @GetIconClass() @GetTextColorClass() @IconSize"></i>
</div>

@code {
    [Parameter] 
    public string Type { get; set; } = "module"; // course, module, activity, student, submission
    
    [Parameter] 
    public string? CustomIcon { get; set; } // Optional: Custom icon rather than types we defined (e.g., "bi-arrow-right", "bi-files", etc.)
    
    [Parameter] 
    public string? IconSize { get; set; } = "fs-3"; // Optional: Custom icon size class (e.g., "fs-1", "fs-2", "fs-3", etc.)

    [Parameter]
	public string? TextColor { get; set; } = null; // Optional: Custom text color class (e.g., "text-primary", "text-success")
    
    [Parameter]
	public string? CustomClasses { get; set; } = null; // Optional: Custom class if needed for additional styling (e.g., "my-custom-class")


    private string GetIconClass() => CustomIcon ?? Type.ToLower() switch
    {
        "course" => "bi-book",
        "module" => "bi-stack",
        "activity" => "bi-calendar-check",
        "student" => "bi-people",
        "assignment" => "bi-file-text",
        "submission" => "bi-file-earmark-arrow-up",
        _ => "bi-folder"
    };

    private string GetTextColorClass() => TextColor ?? Type.ToLower() switch
    {
        "course" => "text-dark",
        "module" => "text-primary",
        "activity" => "text-success",
        "student" => "text-purple",
        "assignment" => "text-warning",
        "submission" => "text-warning",
        _ => "text-secondary"
    };

    private string? GetCustomClasses()
    {
        if (!string.IsNullOrEmpty(CustomClasses) && CustomClasses.Contains("theme-box-background"))
        {
            var baseClasses = "rounded-circle d-flex align-items-center justify-content-center";
            if (!CustomClasses.Contains("icon-square"))
            {
                baseClasses += " icon-square-48";
            }

            return CustomClasses.Replace("theme-box-background", $"{baseClasses} {GetBgColorClasse()}");
        }

        return CustomClasses;
    }

    private string GetBgColorClasse() => Type.ToLower() switch
    {
        "course" => "bg-dark-subtle",
        "module" => "bg-primary-subtle",
        "activity" => "bg-success-subtle",
        "student" => "bg-purple-subtle",
        "assignment" => "bg-warning-subtle",
        "submission" => "bg-warning-subtle",
        
        _ => "bg-light"
    };
}