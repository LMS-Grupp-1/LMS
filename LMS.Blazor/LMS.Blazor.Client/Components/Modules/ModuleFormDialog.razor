@using LMS.Shared.DTOs.CourseDtos
@using LMS.Shared.DTOs.ModulesDtos
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Blazor.Client.Services
@using System.Net
@using System.Net.Http.Json
@inject IApiProxyClient ApiProxy
@inject ToastService ToastService

@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <EditForm Model="moduleModel" OnValidSubmit="HandleSubmitAsync">
                    <DataAnnotationsValidator />
                    
                    <div class="modal-header">
                        <h5 class="modal-title">@(IsEditMode ? "Redigera modul" : "Lägg till modul")</h5>
                        <button type="button" class="btn-close" @onclick="Close"></button>
                    </div>

                    <div class="modal-body">
                        @if (CurrentCourse != null)
                        {
                            <div class="card bg-light border-0 mb-4 p-3">
                                <h6 class="text-primary fw-bold mb-1">Kursinformation</h6>
                                <p class="mb-1"><strong>Namn:</strong> @CurrentCourse.Name</p>
                                <p class="mb-1 text-muted small"><strong>Beskrivning:</strong> @CurrentCourse.Description</p>
                                <div class="text-muted small">
                                    <span><strong>Kursperiod:</strong> @CurrentCourse.StartDate.ToShortDateString() - @CurrentCourse.EndDate.ToShortDateString()</span>
                                </div>
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">Modulnamn <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="moduleModel.Name" />
                            <ValidationMessage For="() => moduleModel.Name" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Beskrivning</label>
                            <InputTextArea class="form-control" @bind-Value="moduleModel.Description" rows="3" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Startdatum <span class="text-danger">*</span></label>
                                <InputDate class="form-control" @bind-Value="moduleModel.StartDate" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Slutdatum <span class="text-danger">*</span></label>
                                <InputDate class="form-control" @bind-Value="moduleModel.EndDate" />
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(submitErrorMessage))
                        {
                            <div class="alert alert-danger mt-3 mb-0">@submitErrorMessage</div>
                        }
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="Close">Avbryt</button>
                        <button type="submit" class="btn btn-primary" disabled="@IsSubmitting">
                            @if (IsSubmitting) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            @(IsEditMode ? "Spara ändringar" : "Skapa")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public int CourseId { get; set; }
    [Parameter] public CourseDto? CurrentCourse { get; set; }
    [Parameter] public ModuleDto? ModuleToEdit { get; set; } // Null = Create mode, Populated = Edit mode
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnModuleSaved { get; set; }

    private CreateModuleDto moduleModel = new();
    private bool IsSubmitting = false;
    private bool IsEditMode => ModuleToEdit != null;
    private string? submitErrorMessage;

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            submitErrorMessage = null;

            if (IsEditMode && ModuleToEdit != null)
            {
                // Populate fields with existing module data for editing
                moduleModel = new CreateModuleDto
                {
                    Name = ModuleToEdit.Name,
                    Description = ModuleToEdit.Description,
                    StartDate = ModuleToEdit.StartDate,
                    EndDate = ModuleToEdit.EndDate
                };
            }
            else
            {
                // Set up defaults for creating a new module
                var startDate = CurrentCourse?.StartDate ?? DateTime.Today;
                moduleModel = new CreateModuleDto 
                { 
                    StartDate = startDate,
                    EndDate = startDate.AddDays(7)
                };
            }
        }
    }

    private async Task Close() => await OnClose.InvokeAsync();

    private async Task HandleSubmitAsync()
    {
        IsSubmitting = true;
        submitErrorMessage = null;

        try
        {
            using var content = JsonContent.Create(moduleModel);

            string? responseErrorMessage;

            if (IsEditMode && ModuleToEdit != null)
            {
                var (_, error) = await ApiProxy.SendAndHandleErrorAsync<bool>(
                    HttpMethod.Put,
                    $"teacher/courses/{CourseId}/modules/{ModuleToEdit.Id}",
                    content
                );
                responseErrorMessage = error;
            }
            else
            {
                var (_, error) = await ApiProxy.SendAndHandleErrorAsync<bool>(
                    HttpMethod.Post,
                    $"teacher/courses/{CourseId}/modules",
                    content
                );
                responseErrorMessage = error;
            }

            // If the backend returned a validation error or 404, display it in the UI banner
            if (!string.IsNullOrEmpty(responseErrorMessage))
            {
                submitErrorMessage = responseErrorMessage switch
                {
                    "The module period must include all exisiting activities." =>
                        "Modulens datum måste omfatta alla befintliga aktiviteter." +
                        "Ändra aktiviteternas datum först om du vill förkorta modulens period.",

                    _ => responseErrorMessage
                };

                return;
            }
            else
            {
                ToastService.ShowToast("Modulen har sparas.", ToastType.Success);
            }

            // Success! Close dialog and trigger refresh
            await OnModuleSaved.InvokeAsync();
            await Close();
        }
        catch (Exception ex)
        {
            // This catches true network dropouts or unexpected client-side exceptions
            submitErrorMessage = ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

}