@using LMS.Shared.DTOs.CourseDtos
@using LMS.Shared.DTOs.ModulesDtos
@using LMS.Shared.DTOs.StatisticsDtos
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Blazor.Client.ViewModels.Modules
@using LMS.Blazor.Client.Components.Common
@using LMS.Blazor.Client.Components.Activities
@inject IApiProxyClient ApiProxy

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h5 class="fw-bold mb-1">MODULER</h5>
            <p class="text-muted small mb-0 px-2">Hantera moduler och tillhörande aktiviteter för denna kurs.</p>
        </div>
        <button class="btn btn-primary" @onclick="OpenAddModuleModal">
            <i class="bi bi-plus-circle"></i>
            <span class="d-none d-md-inline ms-1">Lägg till modul</span>
        </button>
    </div>
    @if (!string.IsNullOrEmpty(moduleListErrorMsg))
    {
        <div class="text-danger my-2">
            <i class="bi bi-exclamation-circle me-1"></i> @moduleListErrorMsg
        </div>
    }

    @if (isLoading)
    {
        <p class="text-muted px-2">Laddar moduler...</p>
    }
    else if (!modules.Any())
    {
        <div class="alert alert-info">Inga moduler hittades för denna kurs.</div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var mod in modules)
            {
                bool isExpanded = expandedModuleIds.Contains(mod.Id);

                <div class="card shadow-sm border-0">
                    <div class="row align-items-center p-3">
                        <div class="col-auto">
                            <AppIconBox Type="module" CustomClasses="theme-box-background" />
                        </div>

                        <div class="col">
                            <h5 class="fw-bold mb-1">@mod.Name</h5>
                            <div class="text-muted small">
                                <i class="bi bi-calendar-week me-1 text-primary"></i>
                                <span>@mod.StartDate.ToShortDateString() - @mod.EndDate.ToShortDateString()</span>
                            </div>

                            @if (moduleErrorMsgs.TryGetValue(mod.Id, out var errorMsg) && !string.IsNullOrEmpty(errorMsg))
                            {
                                <div class="text-danger small mt-2">
                                    <i class="bi bi-exclamation-circle me-1"></i> @errorMsg
                                </div>
                            }
                        </div>

                        <div class="col-auto d-flex align-items-center gap-2">
                            <button class="btn btn-outline-primary btn-sm" @onclick="() => OpenEditModuleModal(mod)">
                                <i class="bi bi-pencil"></i>
                                <span class="d-none d-md-inline ms-1">Redigera modul</span>
                            </button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => PromptDeleteModule(mod.Id, mod.Name)">
                                <i class="bi bi-trash"></i>
                            </button>
                            <button class="btn btn-outline-secondary btn-sm rounded-circle p-2" 
                                    style="width: 32px; height: 32px;" 
                                    @onclick="() => ToggleModuleExpansion(mod.Id)">
                                <i class="bi @(isExpanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
                            </button>
                        </div>
                    </div>

                    @if (isExpanded)
                    {
                        <hr class="m-0 text-muted" />
                        <div>
                            <p class="text-secondary px-3 py-2 mb-0">@(string.IsNullOrEmpty(mod.Description) ? "Ingen beskrivning angiven." : mod.Description)</p>

                            <ActivityList CurrentModule=mod/>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<!-- Unified Form Dialog for both Add and Edit -->
<ModuleFormDialog IsOpen="isModalOpen"
                 CourseId="CourseId"
                 CurrentCourse="CurrentCourse"
                 ModuleToEdit="selectedModule"
                 OnClose="CloseModal"
                 OnModuleSaved="HandleModuleSaved" />

<ConfirmDialog IsOpen="showDeleteModal"
               Title="@($"TA BORT MODUL: {deleteModuleName}")"
               Message="@deleteDialogMsg"
               ConfirmButtonText="@(isDeletable ? "Ta bort" : "Stäng")"
               ConfirmButtonClass="btn-danger"
               OnCancel="CloseDeleteModal"
               OnConfirm="ConfirmDeleteAsync" />

@code {
    [Parameter] public int CourseId { get; set; }
    [Parameter] public CourseDto? CurrentCourse { get; set; }

    private IEnumerable<ModuleViewModel> modules = new List<ModuleViewModel>();
    private bool isLoading = true;
    private string? moduleListErrorMsg = null;

    private ModuleDto? selectedModule = null; // null = Add mode, Has value = Edit mode
    private bool isModalOpen = false;

    private bool showDeleteModal = false;

    private HashSet<int> expandedModuleIds = new();
    private Dictionary<int, string> moduleErrorMsgs = new();
    private int? moduleToDeleteId = null;
    private string? deleteModuleName = null;

    // Get Cascade counts in module
    private ModuleStatisticsDto? moduleStats;
    private string deleteDialogMsg = "";
    private bool isDeletable = false;

    protected override async Task OnParametersSetAsync()
    {
        await LoadModulesAsync();
    }

    private async Task LoadModulesAsync()
    {
        isLoading = true;
        moduleListErrorMsg = null;
        try
        {
            var serviceModules = await ApiProxy.GetAsync<IEnumerable<ModuleDto>>(
                $"modules/in-course/{CourseId}"
            ) ?? Enumerable.Empty<ModuleDto>();

            modules = serviceModules.Select(m => new ModuleViewModel
            {
                Id = m.Id,
                Name = m.Name,
                Description = m.Description,
                StartDate = m.StartDate,
                EndDate = m.EndDate
            }).ToList();
        }
        catch (HttpRequestException ex)
        {
            moduleListErrorMsg = $"Misslyckades med att ladda moduler: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleModuleExpansion(int moduleId)
    {
        if (expandedModuleIds.Contains(moduleId))
        {
            expandedModuleIds.Remove(moduleId);
        }
        else
        {
            expandedModuleIds.Add(moduleId);
        }
    }

    private void OpenAddModuleModal()
    {
        selectedModule = null; // Clear out any previous edit state -> triggers Add Mode
        isModalOpen = true;
    }

    private void OpenEditModuleModal(ModuleViewModel mod)
    {
        selectedModule = new ModuleDto
        {
            Id = mod.Id,
            Name = mod.Name,
            Description = string.IsNullOrEmpty(mod.Description) ? "Ingen beskrivning" : mod.Description,
            StartDate = mod.StartDate,
            EndDate = mod.EndDate
        };

        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
        selectedModule = null;
    }

    private async Task HandleModuleSaved()
    {
        CloseModal();
        await LoadModulesAsync(); // Refresh list after create or update
    }

    private async Task PromptDeleteModule(int moduleId, string moduleName)
    {
        moduleToDeleteId = moduleId;
        deleteModuleName = moduleName;
        isDeletable = false;

        // Get cascade counts in module
        await LoadModuleStatistics();

        showDeleteModal = true;
    }

    private async Task LoadModuleStatistics()
    {
        try
        {
            if (moduleToDeleteId is not null)
            {
                moduleListErrorMsg = null;
                deleteDialogMsg = "";
                isDeletable = false;
                moduleStats = await ApiProxy.GetAsync<ModuleStatisticsDto>(
                    $"modules/{moduleToDeleteId.Value}/statistics");

                if (moduleStats is null)
                {
                    moduleListErrorMsg = $"Kunde inte ladda modulstatistik för att kontrollera radering.";
                    return;
                }
                if (moduleStats.ActivityCount == 0 && moduleStats.AssignmentCount == 0 && moduleStats.DocumentCount == 0)
                {
                    isDeletable = true;
                    deleteDialogMsg = "Är du säker på att du vill ta bort denna modul?\nDenna åtgärd går inte att ångra!";
                }
                else
                {
                    isDeletable = false;
                    deleteDialogMsg = $"Kan inte radera denna modul.\n\nModulen har {moduleStats.ActivityCount} aktivitet(er),\n{moduleStats.AssignmentCount} uppgift(er),\noch {moduleStats.DocumentCount} dokument.\n\nTa bort dem innan du kan radera modulen.";
                }
            }
        }
        catch (Exception ex)
        {
            moduleListErrorMsg = $"Kunde inte ladda modulstatistik: {ex.Message}";
        }
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        moduleToDeleteId = null;
        deleteModuleName = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (moduleToDeleteId == null)
        {
            moduleListErrorMsg = "Ingen modul vald för att radera.";
            return;
        }
        if (!isDeletable)
        {
            CloseDeleteModal();
            return;
        }

        int moduleId = moduleToDeleteId.Value;
        CloseDeleteModal();
        
        moduleErrorMsgs[moduleId] = string.Empty;

        try
        {
            var (success, responseErrorMessage) = await ApiProxy.SendAndHandleErrorAsync<bool>(
                HttpMethod.Delete,
                $"modules/in-course/{CourseId}/{moduleId}"
            );

            if (string.IsNullOrEmpty(responseErrorMessage))
            {
                moduleErrorMsgs.Remove(moduleId);
                await LoadModulesAsync();
            }
            else
            {
                moduleErrorMsgs[moduleId] = responseErrorMessage ?? "Det gick inte att ta bort modulen. Försök igen.";
            }
        }
        catch (Exception ex)
        {
            moduleErrorMsgs[moduleId] = $"Ett fel uppstod: {ex.Message}";
        }
    }
}