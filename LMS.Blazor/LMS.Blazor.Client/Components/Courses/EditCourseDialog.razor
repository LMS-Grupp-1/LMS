@using LMS.Shared.DTOs.CourseDtos
@using LMS.Blazor.Client.Services
@using LMS.Blazor.Client.Services.ApiProxy
@inject IApiProxyClient ApiProxy
@inject ToastService ToastService

@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Redigera kurs</h5>
                    <button type="button" class="btn-close" disabled="@isSubmitting" @onclick="CloseAsync"></button>
                </div>

                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(formError))
                    {
                        <div class="alert alert-danger" role="alert">
                            @formError
                        </div>
                    }

                    <CourseForm Model="CourseEditModel"
                                OnSaveCourse="SaveCourse"
                                OnCancel="CloseAsync"
                                SubmitButtonText="Spara kurs"
                                IsBusy="isSubmitting" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public CourseCreateDto? CourseEditModel { get; set; }
    [Parameter] public EventCallback OnCourseUpdated { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private bool isSubmitting = false;
    private string? formError;

    private async Task SaveCourse()
    {
        if (isSubmitting || CourseEditModel == null) return;
        formError = null;

        if (string.IsNullOrWhiteSpace(CourseEditModel.Name) ||
            CourseEditModel.Name.Trim().Length > 50)
        {
            formError = "Registrera ett kursnamn mellan 1-50 tecken.";
            return;
        }

        if (CourseEditModel.StartDate > CourseEditModel.EndDate)
        {
            formError = "Startdatum får inte ligga efter slutdatum.";
            return;
        }

        if ((CourseEditModel.Description?.Length ?? 0) > 1000)
        {
            formError = "Beskrivningen får innehålla högst 1000 tecken.";
            return;
        }

        isSubmitting = true;
        try
        {
            CourseEditModel.Name = CourseEditModel.Name.Trim();

            var updateDto = new CourseUpdateDto(
                CourseEditModel.Name,
                CourseEditModel.Description ?? string.Empty,
                CourseEditModel.StartDate,
                CourseEditModel.EndDate);

            var (_, errorMessage) =
                await ApiProxy.SendAndHandleErrorAsync<object>(
                    HttpMethod.Put,
                    $"courses/{CourseEditModel.Id}",
                    JsonContent.Create(updateDto));

            if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                formError = errorMessage switch
                {
                    "A course with this name already exists." =>
                    "Det finns redan en kurs med det namnet.",

                    _ =>
                        "Kursen kunde inte sparas. Kontrollera uppgifterna och försök igen."
                };

                return;
            }
            ToastService.ShowToast($"Kursen {CourseEditModel.Name} har sparats.", ToastType.Success);

            await OnCourseUpdated.InvokeAsync(); // Notify parent to refresh list
            await CloseAsync();
        }
        catch (UnauthorizedAccessException)
        {
            formError = "Din session har gått ut. Logga in igen.";
        }
        catch (Exception)
        {
            formError = "Kursen kunde inte sparas. " +
            "Kontrollera uppgifterna innan du försöker igen.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task CloseAsync() => await OnClose.InvokeAsync();
}