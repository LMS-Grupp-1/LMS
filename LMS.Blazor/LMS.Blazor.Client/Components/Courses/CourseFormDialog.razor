@code {
    [Parameter] public IEnumerable<CourseDto>? courses { get; set; }
    [Parameter] public bool IsOpen { get; set; } = false;
    [Parameter] public CourseDto? CourseToEdit { get; set; } // Null = Create mode, Populated = Edit mode    
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnCourseSaved { get; set; }
    [Parameter] public ICourseService CourseService { get; set; } = default!;

    private CourseCreateDto courseModel = new();
    private bool IsSubmitting = false;
    private bool IsEditMode => CourseToEdit != null;
    private string? formError;
    private int editingCourseId => CourseToEdit?.Id ?? 0;

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            formError = null;

            if (IsEditMode && CourseToEdit != null)
            {
                // Populate fields with existing course data for editing                
                courseModel = new CourseCreateDto
                {
                    Name = CourseToEdit.Name,
                    Description = CourseToEdit.Description,
                    StartDate = CourseToEdit.StartDate,
                    EndDate = CourseToEdit.EndDate
                };
            }
            else
            {
                // Set up defaults for creating a new course                
                courseModel = new CourseCreateDto
                {
                    StartDate = DateTime.Today,
                    EndDate = DateTime.Today.AddMonths(1)
                };
            }
        }
    }

    private async Task CloseModal(Microsoft.AspNetCore.Components.Web.MouseEventArgs e) 
    {
        await OnClose.InvokeAsync();
    }

    private async Task HandleSubmitAsync()
    {
        if (IsSubmitting) return;
        formError = null;

        if (string.IsNullOrWhiteSpace(courseModel.Name) ||
            courseModel.Name.Trim().Length > 50)
        {
            formError = "Registrera ett kursnamn mellan 1-50 tecken.";
            return;
        }

        if (courses != null && courses.Any(course =>
            (!IsEditMode || course.Id != editingCourseId) && string.Equals(
                course.Name.Trim(),
                courseModel.Name.Trim(),
                StringComparison.OrdinalIgnoreCase)))
        {
            formError = "Det existerar redan en kurs med det här namnet.";
            return;
        }

        var today = DateTime.Today;
        if (courseModel.StartDate.Date < today ||
            courseModel.EndDate.Date < today)
        {
            formError = "Kursdatum får inte ligga före dagens datum.";
            return;
        }

        if (courseModel.StartDate > courseModel.EndDate)
        {
            formError = "Startdatum får inte ligga efter slutdatum.";
            return;
        }

        IsSubmitting = true;

        try
        {
            if (IsEditMode && CourseToEdit != null)
            {
                var success = await CourseService.UpdateCourseAsync(CourseToEdit.Id, courseModel);
                if (!success)
                {
                    formError = "Det gick inte att uppdatera kursen. Försök igen.";
                    return;
                }
            }
            else
            {
                var success = await CourseService.CreateCourseAsync(courseModel);
                if (!success)
                {
                    formError = "Det gick inte att skapa kursen. Försök igen.";
                    return;
                }
            }

            await OnCourseSaved.InvokeAsync();
            await CloseModal();
        }
        catch (Exception ex)
        {
            formError = $"Ett fel uppstod: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }
}
