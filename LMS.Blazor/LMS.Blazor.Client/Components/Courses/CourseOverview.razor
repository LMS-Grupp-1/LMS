@using LMS.Shared.DTOs.CourseDtos
@using LMS.Blazor.Client.Components.Common

<div class="container-fluid px-0">

    <div class="row g-4 mb-4">

        <!-- Course Statistics -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 p-4 h-100">
                <h5 class="fw-bold mb-3 text-uppercase">Kursstatistik</h5>
                
                <div class="row g-3">
                    <div class="col-6">
                        <div class="p-3 rounded d-flex align-items-center gap-3" style="background-color: #e3f2fd;">
                            <AppIconBox Type="module" />
                            <div>
                                <span class="text-muted small d-block">Moduler</span>
                                <h4 class="fw-bold mb-0 text-primary">@ModuleCount</h4>
                            </div>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="p-3 rounded d-flex align-items-center gap-3" style="background-color: #e8f5e9;">
                            <AppIconBox Type="activity" />
                            <div>
                                <span class="text-muted small d-block">Aktiviteter</span>
                                <h4 class="fw-bold mb-0 text-success">@ActivityCount</h4>
                            </div>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="p-3 rounded d-flex align-items-center gap-3 bg-purple-subtle">
                            <AppIconBox Type="student" />
                            <div>
                                <span class="text-muted small d-block">Studenter</span>
                                <h4 class="fw-bold mb-0 text-purple">@StudentCount</h4>
                            </div>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="p-3 rounded d-flex align-items-center gap-3" style="background-color: #fffde7;">
                            <AppIconBox Type="assignment" />
                            <div>
                                <span class="text-muted small d-block">Uppgifter</span>
                                <h4 class="fw-bold mb-0 text-warning">@SubmissionCount</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Assignments and Submissions -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 p-4 h-100">
                <h5 class="fw-bold mb-3 text-uppercase">Alla uppgifter</h5>

                <!-- Assignment summary counts -->
                <div class="d-flex justify-content-between align-items-center px-3 py-2 bg-warning-subtle rounded-3 mb-3 small text-muted">
                    <span><AppIconBox Type="assignment" IconSize="sm" /> <strong>Totalt:</strong> 5</span>
                    <span><AppIconBox Type="submission" IconSize="sm" /> <strong class="text-truncate">Inlämningsuppgifter:</strong> 4</span>
                    <span><AppIconBox Type="assignment" IconSize="sm" /> <strong>Övriga:</strong> 1</span>
                </div>

                <!-- Requires Submit Assignment List -->
                <h6 class="fw-semibold text-secondary small mb-2">Inlämningsuppgifter</h6>
        
                <div class="overflow-y-auto pe-1" style="max-height: 132px;">
                    <div class="d-flex flex-column gap-2">
                        @foreach (var assignment in requiresSubmitAssignments)
                        {
                            <div class="p-2 px-3 border rounded-2 bg-white d-flex align-items-center justify-content-between small">
                                <div class="text-truncate me-3">
                                    <span class="text-dark text-truncate">@assignment.AssignmentName</span>
                                    <span class="text-danger ms-2">
                                        <i class="bi bi-hourglass-split me-1"></i>@assignment.Deadline.ToString("yyyy-MM-dd HH:mm")
                                    </span>
                                </div>
                        
                                <div class="d-flex align-items-center gap-3 text-nowrap text-muted">
                                    <span title="Inlämnade">
                                        <AppIconBox Type="submitted" IconSize="sm" /> @assignment.SubmissionCount
                                    </span>
                                    <span title="Bedömda">
                                        <AppIconBox Type="feedback" IconSize="sm" /> @assignment.FeedbackCount
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm border-0 p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">Senaste aktiviteter</h5>
            <a href="javascript:void(0);" class="text-decoration-none small fw-semibold text-primary">Visa alla &gt;</a>
        </div>

        <div class="d-flex flex-column gap-3">
            <div class="d-flex align-items-start gap-3 p-2 border-bottom pb-3">
                <div class="fs-4 text-secondary mt-1"><i class="bi bi-file-earmark-text"></i></div>
                <div>
                    <p class="mb-0 fw-semibold text-dark">Anna Andersson lämnade in uppgift Java applikation</p>
                    <span class="text-muted small">2 timmar sedan</span>
                </div>
            </div>

            <div class="d-flex align-items-start gap-3 p-2">
                <div class="fs-4 text-secondary mt-1"><i class="bi bi-file-earmark-text"></i></div>
                <div>
                    <p class="mb-0 fw-semibold text-dark">Karl Karlsson lade till en ny aktivitet i Modul 1</p>
                    <span class="text-muted small">5 timmar sedan</span>
                </div>
            </div>
        </div>
    </div>

</div>

@code {
    [Parameter] public CourseDto? Course { get; set; }

    // Metrics and Progress Parameters
    [Parameter] public int AverageProgress { get; set; } = 65;
    [Parameter] public int ModuleCount { get; set; } = 3;
    [Parameter] public int ActivityCount { get; set; } = 11;
    [Parameter] public int StudentCount { get; set; } = 5;
    [Parameter] public int SubmissionCount { get; set; } = 3;

    [Parameter] public IEnumerable<ModuleProgressModel>? Modules { get; set; }

    protected override void OnInitialized()
    {
        // Fallback mock module progress rows if none passed from parent
        if (Modules == null || !Modules.Any())
        {
            Modules = new List<ModuleProgressModel>
            {
                new() { Name = "Introduktion till C#", Progress = 100 },
                new() { Name = "Blazor WebAssembly", Progress = 60 },
                new() { Name = "Clean Architecture", Progress = 35 }
            };
        }
    }

    public class ModuleProgressModel
    {
        public string Name { get; set; } = string.Empty;
        public int Progress { get; set; }
    }

    private class MockAssignmentDto
    {
        public string AssignmentName { get; set; } = string.Empty;
        public DateTime Deadline { get; set; }
        public int SubmissionCount { get; set; }
        public int FeedbackCount { get; set; }
    }

    private List<MockAssignmentDto> requiresSubmitAssignments = new()
    {
        new() { AssignmentName = "C# Advanced LINQ Lab", Deadline = DateTime.Today.AddDays(3).AddHours(23), SubmissionCount = 18, FeedbackCount = 12 },
        new() { AssignmentName = "Blazor Component Architecture", Deadline = DateTime.Today.AddDays(7).AddHours(17), SubmissionCount = 10, FeedbackCount = 4 },
        new() { AssignmentName = "Entity Framework Core Migration", Deadline = DateTime.Today.AddDays(14).AddHours(23), SubmissionCount = 5, FeedbackCount = 0 },
        new() { AssignmentName = "ASP.NET Core Web API Security", Deadline = DateTime.Today.AddDays(21).AddHours(23), SubmissionCount = 2, FeedbackCount = 0 },
        new() { AssignmentName = "Unit Testing with xUnit", Deadline = DateTime.Today.AddDays(28).AddHours(23), SubmissionCount = 0, FeedbackCount = 0 }
    };
}