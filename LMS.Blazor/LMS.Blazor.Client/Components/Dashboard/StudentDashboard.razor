@using System.Globalization
@using System.Net
@using LMS.Blazor.Client.Helpers
@using LMS.Blazor.Client.Services
@using LMS.Shared.DTOs.DashboardDtos
@implements IAsyncDisposable

@inject IDashboardService DashboardService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

@if (isLoading)
{
    <div class="d-flex align-items-center gap-2 text-muted p-4">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span>Hämtar översikt...</span>
    </div>
}
else if (errorMessage is not null)
{
    <div class="alert alert-warning m-4">@errorMessage</div>
}
else if (dashboard is not null)
{
    <div class="container-fluid py-4">
        @* Course and current module *@
        <div class="mb-4">
            <h1 class="h3 fw-bold mb-1">@dashboard.Course.Name</h1>
            <div class="text-muted">
                @if (dashboard.CurrentModule is { } module)
                {
                    <span><i class="bi bi-bookmark"></i> Pågående modul: <strong>@module.Name</strong>
                        (@FormatDate(module.StartDate) – @FormatDate(module.EndDate))</span>
                }
                else
                {
                    <span>Ingen modul pågår just nu.</span>
                }
            </div>
        </div>

        @* Overdue assignments first and in red: this is what needs to be done now *@
        @if (dashboard.OverdueAssignments.Count > 0)
        {
            <div class="alert alert-danger">
                <h2 class="h6 fw-bold mb-2">
                    <i class="bi bi-exclamation-triangle"></i>
                    Försenade uppgifter (@dashboard.OverdueAssignments.Count)
                </h2>
                <ul class="mb-2">
                    @foreach (var assignment in dashboard.OverdueAssignments)
                    {
                        <li>@assignment.Name – deadline @FormatDateTime(assignment.Deadline)</li>
                    }
                </ul>
                <a href="assignments" class="alert-link small">Lämna in under Mina uppgifter &gt;</a>
            </div>
        }

        <div class="row g-4">
            @* Upcoming activities *@
            <div class="col-lg-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h2 class="h5 fw-bold m-0">Kommande aktiviteter</h2>
                            <a href="my-course" class="small text-decoration-none">Min kurs &gt;</a>
                        </div>
                        @if (dashboard.UpcomingActivities.Count == 0)
                        {
                            <p class="text-muted mb-0">Inga kommande aktiviteter.</p>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var activity in dashboard.UpcomingActivities)
                                {
                                    <li class="list-group-item px-0">
                                        <div class="fw-semibold">@activity.Name</div>
                                        <small class="text-muted">
                                            @FormatDateTime(activity.StartDate)–@activity.EndDate.ToString("HH:mm", CultureInfo.InvariantCulture)
                                            · @activity.ActivityType · @activity.ModuleName
                                        </small>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>

            @* Upcoming deadlines with status *@
            <div class="col-lg-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h2 class="h5 fw-bold m-0">Kommande deadlines</h2>
                            <a href="assignments" class="small text-decoration-none">Alla uppgifter &gt;</a>
                        </div>
                        @if (dashboard.UpcomingDeadlines.Count == 0)
                        {
                            <p class="text-muted mb-0">Inga kommande deadlines.</p>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var assignment in dashboard.UpcomingDeadlines)
                                {
                                    var (statusText, statusClass) = AssignmentStatusDisplay.For(assignment.Status);

                                    <li class="list-group-item px-0 d-flex justify-content-between align-items-start gap-2">
                                        <div>
                                            <div class="fw-semibold">@assignment.Name</div>
                                            <small class="text-muted">Deadline @FormatDateTime(assignment.Deadline)</small>
                                        </div>
                                        <span class="badge @statusClass">@statusText</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>

            @* Feedback from the teacher *@
            <div class="col-lg-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h2 class="h5 fw-bold mb-3">Feedback</h2>
                        @if (dashboard.AssignmentsWithFeedback.Count == 0)
                        {
                            <p class="text-muted mb-0">Ingen feedback ännu.</p>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var assignment in dashboard.AssignmentsWithFeedback)
                                {
                                    <li class="list-group-item px-0">
                                        <i class="bi bi-chat-left-text me-1"></i>
                                        <a href="assignments" class="text-decoration-none">@assignment.Name</a>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>

            @* Newest course documents *@
            <div class="col-lg-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h2 class="h5 fw-bold mb-3">Senaste dokument</h2>
                        @if (downloadError is not null)
                        {
                            <div class="text-danger small mb-2">@downloadError</div>
                        }
                        @if (dashboard.RecentDocuments.Count == 0)
                        {
                            <p class="text-muted mb-0">Inga dokument ännu.</p>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var document in dashboard.RecentDocuments)
                                {
                                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center gap-2">
                                        <div>
                                            <div class="fw-semibold">@document.Name</div>
                                            <small class="text-muted">
                                                @document.Location · @document.UploadedAt.ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                                            </small>
                                        </div>
                                        <button type="button"
                                                class="btn btn-outline-primary btn-sm"
                                                disabled="@(downloadingId is not null)"
                                                aria-label="@($"Ladda ner {document.Name}")"
                                                @onclick="() => DownloadAsync(document.Id, document.FileName)">
                                            @(downloadingId == document.Id ? "Hämtar..." : "Ladda ner")
                                        </button>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private StudentDashboardDto? dashboard;
    private bool isLoading = true;
    private string? errorMessage;
    private int? downloadingId;
    private string? downloadError;
    private IJSObjectReference? downloadModule;
    private readonly CancellationTokenSource componentCancellation = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await DashboardService.GetStudentDashboardAsync(componentCancellation.Token);

            // The server-side prerender service deliberately returns null.
            // Keep showing the loading state until WebAssembly runs this again.
            if (result is null)
            {
                return;
            }

            dashboard = result;
            isLoading = false;
        }
        catch (OperationCanceledException) when (componentCancellation.IsCancellationRequested)
        {
            // Navigating away disposes the component and cancels its request.
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo(
                $"Account/Login?returnUrl={Uri.EscapeDataString(NavigationManager.Uri)}",
                forceLoad: true);
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            // The API returns 404 when the student is not enrolled in a course
            errorMessage = "Du är inte kopplad till någon kurs ännu.";
            isLoading = false;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Översikten kunde inte hämtas. Försök igen senare.";
            isLoading = false;
        }
    }

    private async Task DownloadAsync(int documentId, string fileName)
    {
        downloadingId = documentId;
        downloadError = null;

        try
        {            
            // The API checks that the document belongs to the student's course.
            downloadModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", NavigationManager.ToAbsoluteUri("js/documents.js").ToString());

            var url = NavigationManager.ToAbsoluteUri($"api/proxy/documents/{documentId}/download").ToString();
            var status = await downloadModule.InvokeAsync<int>("download", url, fileName);

            if (status != 200)
            {
                downloadError = "Filen kunde inte hämtas. Försök igen.";
            }
        }
        catch (JSException)
        {
            downloadError = "Filen kunde inte hämtas. Försök igen.";
        }
        finally
        {
            downloadingId = null;
        }
    }

    private static string FormatDate(DateTime date) =>
        date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private static string FormatDateTime(DateTime? date) =>
        date?.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) ?? "Ingen";

    public async ValueTask DisposeAsync()
    {
        componentCancellation.Cancel();
        componentCancellation.Dispose();

        if (downloadModule is not null)
        {
            try
            {
                await downloadModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser has already closed the connection.
            }
        }
    }
}