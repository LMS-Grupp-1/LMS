
@using LMS.Blazor.Client.Components.Common
@using LMS.Shared.DTOs
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Blazor.Client.Helpers
@inject IApiProxyClient ApiProxy

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 fw-bold text-dark">Lärarens Dashboard</h1>
        </div>
    </div>

    @if (errorMessage != null)
    {
        <div class="alert alert-danger text-center py-3 mb-0">
            @errorMessage
        </div>
    }

    <div class="row g-4 mb-4">
        <!-- Active courses -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body bg-light p-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title fw-bold m-0">Aktiva kurser</h5>
                        <a href="/teacher/courses" class="text-decoration-none text-primary fw-semibold small">Visa alla &gt;</a>
                    </div>

                    @if (activeCourses == null)
                    {
                        <div class="d-flex justify-content-center align-items-center py-4">
                            <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                            <span class="text-muted">Laddar...</span>
                        </div>
                    }
                    else if (!activeCourses.Any())
                    {
                        <div class="alert alert-light text-center text-muted border py-3 mb-0">
                            Inga aktiva kurser hittades.
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var course in activeCourses)
                            {
                                <div class="card border bg-white shadow-none p-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <NavLink href="@($"/teacher/courses/{course.Id}")" class="text-decoration-none">
                                                <h6 class="fw-bold link-primary mb-1">@course.Name</h6>
                                            </NavLink>
                                            <span class="text-muted small">
                                                @course.StartDate.ToString("yyyy-MM-dd") – @course.EndDate.ToString("yyyy-MM-dd")
                                            </span>
                                        </div>
                                        <div class="text-end">
                                            <span class="d-block fw-bold text-dark">@course.StudentCount elever</span>
                                            <span class="text-muted small">@course.ModuleCount moduler</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Recent assignments + submissions -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body bg-light p-3">
                    <h5 class="card-title fw-bold mb-3">Senaste inlämningar</h5>

                    @if (activeAssignments == null && latestSubmissions == null)
                    {
                        <div class="d-flex justify-content-center align-items-center py-4">
                            <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                            <span class="text-muted">Laddar...</span>
                        </div>
                    }
                    else if ((activeAssignments != null && !activeAssignments.Any()) && (latestSubmissions != null && !latestSubmissions.Any()))
                    {
                        <div class="alert alert-light text-center text-muted border py-3 mb-0">
                            Inga aktiva uppgifter eller inlämningar hittades.
                        </div>
                    }
                    else
                    {
                        <div class="overflow-y-auto pe-2" style="max-height: 250px;">
                            <div class="d-flex flex-column gap-2">
                                @if (activeAssignments != null && activeAssignments.Any())
                                {
                                    @foreach (var assignment in activeAssignments)
                                    {
                                        <div class="card border bg-white shadow-none p-2">
                                            <div class="d-flex align-items-center gap-3">
                                                <AppIconBox Type="assignment" CustomClasses="theme-box-background icon-square-40" IconSize="fs-4" />
                                                <div>
                                                    <p class="mb-0 text-break small"> 
                                                        <span class="text-dark">@assignment.AssignmentName</span>
                                                        <span class="text-muted">har lägts in @assignment.CourseName</span>
                                                    </p>
												    @if (assignment.Deadline != null)
												    {
													    <span class="text-danger" style="font-size: 0.75rem;">DEADLINE: @assignment.Deadline.Value.ToString("yyyy-MM-dd HH:mm")</span>
												    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                
                                @if (latestSubmissions != null && latestSubmissions.Any())
                                {
                                    @foreach (var submission in latestSubmissions)
                                    {
                                        <div class="card border bg-white shadow-none p-2">
                                            <div class="d-flex align-items-center gap-3">
											    <AppIconBox Type="submission" CustomClasses="theme-box-background icon-square-40" IconSize="fs-4" />
                                                <div>
                                                    <p class="mb-0 text-dark small">@submission.StudentName har lämnat in "@submission.AssignmentName"</p>
                                                    <span class="text-muted" style="font-size: 0.75rem;">på @submission.SubmittedAt.ToString("yyyy-MM-dd HH:mm")</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Upcoming Activities -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body bg-light p-3">
                    <h5 class="card-title fw-bold mb-3">Kommande aktiviteter</h5>

                    @if (upcomingActivities == null)
                    {
                        <div class="d-flex justify-content-center align-items-center py-4">
                            <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                            <span class="text-muted">Laddar...</span>
                        </div>
                    }
                    else if (!upcomingActivities.Any())
                    {
                        <div class="alert alert-light text-center text-muted border py-3 mb-0">
                            Inga kommande aktiviteter hittades.
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var activity in upcomingActivities)
                            {
                                <div class="card border bg-white shadow-none p-3">
                                    <div class="row align-items-center">
                                        <div class="col-md mb-2 mb-md-0">
                                            <div class="d-flex align-items-center gap-3">
                                                <span class="badge @ActivityTypeHelper.GetBadgeClass(activity.ActivityTypeId) px-3 py-2 rounded-pill fw-semibold">
                                                    @ActivityTypeHelper.GetName(activity.ActivityTypeId)
                                                </span>
                                                <div>
                                                    <h6 class="fw-bold mb-1 text-dark text-break">@activity.ActivityName</h6>
                                                    <span class="text-muted small text-break">Kurs: 
                                                        <NavLink href="@($"/teacher/courses/{activity.CourseId}")" class="text-decoration-none">
                                                            <span class="link-primary">@activity.CourseName</span>
                                                        </NavLink> 
                                                        > @activity.ModuleName</span>
                                                </div>
                                            </div>
                                        </div>

                                        @if (activity.StartDate.Date == activity.EndDate.Date)
                                        {
                                            <div class="col-md-auto text-md-end text-muted small">
                                                <div class="d-flex flex-md-column align-items-md-end justify-content-between gap-1">
                                                    <div>
                                                        <i class="bi bi-calendar-event me-1"></i> @activity.StartDate.ToString("yyyy-MM-dd")
                                                    </div>
                                                    <div>
                                                        <i class="bi bi-clock me-1"></i> @activity.StartDate.ToString("HH:mm") – @activity.EndDate.ToString("HH:mm")
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="col-md-auto text-md-end text-muted small">
                                                <div class="d-flex flex-md-column align-items-md-end justify-content-between gap-1">
                                                    <div>
                                                        <i class="bi bi-calendar-range me-1"></i> @activity.StartDate.ToString("yyyy-MM-dd HH:mm")
                                                    </div>
                                                    <div>
                                                        Till @activity.EndDate.ToString("yyyy-MM-dd HH:mm")
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<DashboardCourseDto>? activeCourses;
    private IReadOnlyList<DashboardAssignmentDto>? activeAssignments;
    private IReadOnlyList<DashboardSubmissionDto>? latestSubmissions;
    private IReadOnlyList<DashboardActivityViewDto>? upcomingActivities;

	private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            LoadActiveCoursesAsync(),
            LoadActiveAssignmentsAsync(),
            LoadLatestSubmissionsAsync(),
            LoadUpcomingActivitiesAsync()
        );
    }

    private async Task LoadActiveCoursesAsync()
    {
        try
        {
            errorMessage = null;
            activeCourses = await ApiProxy.GetAsync<IReadOnlyList<DashboardCourseDto>>("teacher-dashboard/active-courses");
        }
        catch (Exception ex)
        {
            errorMessage = $"Kunde inte ladda aktiva kurser. {ex.Message}";
        }
    }

    private async Task LoadActiveAssignmentsAsync()
    {
        try
        {
            errorMessage = null;
			activeAssignments = await ApiProxy.GetAsync<IReadOnlyList<DashboardAssignmentDto>>("teacher-dashboard/active-assignments");
        }
        catch (Exception ex)
        {
            errorMessage = $"Kunde inte ladda aktiva uppgifter. {ex.Message}";
        }
    }

    private async Task LoadLatestSubmissionsAsync()
    {
        try
        {
            errorMessage = null;
            var afterDate = DateTime.Today.AddDays(-7);
            latestSubmissions = await ApiProxy.GetAsync<IReadOnlyList<DashboardSubmissionDto>>(
                $"teacher-dashboard/latest-submissions?afterDate={afterDate:yyyy-MM-dd}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Kunde inte ladda senaste inlämningar. {ex.Message}";
        }
    }

    private async Task LoadUpcomingActivitiesAsync()
    {
        var startDate = "2026-09-01";// DateTime.Today.ToString("yyyy-MM-dd");
        var endDate = "2026-12-30";// DateTime.Today.AddDays(7).ToString("yyyy-MM-dd");

		try
		{
			errorMessage = null;
            upcomingActivities = await ApiProxy.GetAsync<IReadOnlyList<DashboardActivityViewDto>>(
                $"teacher-dashboard/upcoming-activities?startDate={startDate}&endDate={endDate}");
		}
		catch (Exception ex)
		{
			errorMessage = $"Kunde inte ladda kommande aktiviteter. {ex.Message}";
		}
    }

}