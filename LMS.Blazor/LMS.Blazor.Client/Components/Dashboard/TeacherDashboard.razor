
@using LMS.Shared.DTOs
@using LMS.Blazor.Client.Services.ApiProxy
@inject IApiProxyClient ApiProxy

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 fw-bold text-dark">Lärarens Dashboard</h1>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Aktiva kurser -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title fw-bold m-0">Aktiva kurser</h5>
                        <a href="/teacher/courses" class="text-decoration-none text-primary fw-semibold small">Visa alla &gt;</a>
                    </div>

                    @if (activeCourses == null)
                    {
                        <div class="d-flex justify-content-center align-items-center py-4">
                            <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                            <span class="text-muted">Laddar aktiva kurser...</span>
                        </div>
                    }
                    else if (!activeCourses.Any())
                    {
                        <div class="alert alert-light text-center text-muted border py-3 mb-0">
                            Inga aktiva kurser hittades.
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var course in activeCourses)
                            {
                                <div class="card border bg-light shadow-none p-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <NavLink href="@($"/teacher/courses/{course.Id}")">
                                                <h6 class="fw-bold mb-1 link-primary">@course.Name</h6>
                                            </NavLink>
                                            <span class="text-muted small">
                                                @course.StartDate.ToString("yyyy-MM-dd") – @course.EndDate.ToString("yyyy-MM-dd")
                                            </span>
                                        </div>
                                        <div class="text-end">
                                            <span class="d-block fw-bold text-dark">@course.StudentCount elever</span>
                                            <span class="text-muted small">@course.ModuleCount moduler</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Senaste aktivitet -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-3">Senaste aktivitet</h5>

                    <!-- Scroll container set to show 3 rows -->
                    <div class="overflow-y-auto pe-2" style="max-height: 250px;">
                        <div class="d-flex flex-column m-2 gap-3">
                            @foreach (var activity in recentActivities)
                            {
                                <div class="card border bg-white shadow-none p-2.5">
                                    <div class="d-flex align-items-center m-2 gap-3">
                                        <!-- Activity type Icon -->
                                        <div class="rounded-circle bg-warning bg-opacity-25 text-warning d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px;">
                                            <i class="bi bi-file-text"></i>
                                        </div>
                                        <div>
                                            <p class="mb-0 text-dark small">@activity.Description</p>
                                            <span class="text-muted" style="font-size: 0.75rem;">@activity.TimeAgo</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Div 2: Kommande aktiviteter -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-3">Kommande aktiviteter</h5>

                    <div class="d-flex flex-column gap-3">
                        @foreach (var upcoming in upcomingActivities)
                        {
                            <div class="card border bg-light shadow-none p-3">
                                <div class="row align-items-center">
                                    <!-- Left side: Activity Type badge & name -->
                                    <div class="col-md-7 mb-2 mb-md-0">
                                        <div class="d-flex align-items-center gap-3">
                                            <span class="badge bg-info bg-opacity-25 text-dark px-3 py-2 rounded-pill fw-semibold">
                                                @upcoming.ActivityType
                                            </span>
                                            <div>
                                                <h6 class="fw-bold mb-1 text-dark">@upcoming.ActivityName</h6>
                                                <span class="text-muted small">Kurs: @upcoming.CourseName</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Right side: Date and Time with icons -->
                                    <div class="col-md-5 text-md-end text-muted small">
                                        <div class="d-flex flex-md-column align-items-md-end justify-content-between gap-1">
                                            <div>
                                                <i class="bi bi-calendar-event me-1"></i> @upcoming.StartDate
                                            </div>
                                            <div>
                                                <i class="bi bi-clock me-1"></i> @upcoming.StartTime
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    // Mock Data Models & Lists
    private IEnumerable<DashboardCourseDto>? activeCourses;

    private List<RecentActivityDto> recentActivities = new()
    {
        new() { Description = "Anna Andersson lämnade in uppgift \"HTML-struktur\"", TimeAgo = "2 timmar sedan" },
        new() { Description = "Johan Berg ställde en fråga i forumet", TimeAgo = "4 timmar sedan" },
        new() { Description = "Maria Lind uppdaterade sin profil", TimeAgo = "1 dag sedan" },
        new() { Description = "Karl Svensson lämnade in uppgift \"C# Basics\"", TimeAgo = "2 dagar sedan" },
        new() { Description = "Elin Ek lade till en kommentar på föreläsning 3", TimeAgo = "3 dagar sedan" }
    };

    private List<UpcomingActivityDto> upcomingActivities = new()
    {
        new() { ActivityType = "Inlämning", ActivityName = "Slutprojekt Frontend", CourseName = "Fullstack .NET Utveckling", StartDate = "2026-11-01", StartTime = "15:00" },
        new() { ActivityType = "Föreläsning", ActivityName = "Dependency Injection i ASP.NET Core", CourseName = "Avancerad C# & EF Core", StartDate = "2026-11-03", StartTime = "10:00" },
        new() { ActivityType = "Test / Quiz", ActivityName = "Databasdesign & Normalisering", CourseName = "Webbaserade Applikationer", StartDate = "2026-11-05", StartTime = "13:30" }
    };

    private class RecentActivityDto
    {
        public string Description { get; set; } = string.Empty;
        public string TimeAgo { get; set; } = string.Empty;
    }

    private class UpcomingActivityDto
    {
        public string ActivityType { get; set; } = string.Empty;
        public string ActivityName { get; set; } = string.Empty;
        public string CourseName { get; set; } = string.Empty;
        public string StartDate { get; set; } = string.Empty;
        public string StartTime { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadActiveCoursesAsync();
    }

    private async Task LoadActiveCoursesAsync()
    {
        activeCourses = await ApiProxy.GetAsync<IEnumerable<DashboardCourseDto>>("teacher-dashboard/active-courses") ?? Enumerable.Empty<DashboardCourseDto>();
        StateHasChanged();
    }

}