@if (!string.IsNullOrWhiteSpace(Message))
{
    var statusMessageClass = Message.StartsWith("Error", StringComparison.OrdinalIgnoreCase)
        ? "danger"
        : "success";

    <div class="alert alert-@statusMessageClass" role="alert">
        @Message
    </div>
}

@code {
    [Parameter]
    public string? Message { get; set; }
}
