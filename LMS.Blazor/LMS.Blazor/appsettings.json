{
  "ReverseProxy": {
    "Routes": {
      "remote-api-read": {
        "ClusterId": "remote-api",
        "Match": {
          "Path": "/api/proxy/{**catch-all}",
          "Methods": [ "GET", "POST", "PUT", "PATCH", "DELETE" ]
        },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" },
          { "RequestHeaderRemove": "Cookie" },
          { "RequestHeaderRemove": "X-XSRF-TOKEN" }
        ]
      }
    },
    "Clusters": {
      "remote-api": {
        "Destinations": {
          "primary": {
            "Address": "https://localhost:7003/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
